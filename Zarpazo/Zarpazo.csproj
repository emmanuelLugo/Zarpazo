<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.5.1</Version>
    <!-- Shown in the .exe's Properties > Details tab. -->
    <Authors>provisorio43</Authors>
    <Copyright>© 2026 provisorio43</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Zarpazo.ico</ApplicationIcon>
    <!-- WFAC010 prefers SetHighDpiMode, which only applies to apps that start through WinForms; WPF reads the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zarpazo.Tests" />
  </ItemGroup>

  <!-- The same icon, embedded again so the tray can load the size that fits the screen's scaling. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Zarpazo.ico" LogicalName="Zarpazo.ico" />
  </ItemGroup>

  <!-- WinForms is only here for NotifyIcon and the screen metrics; its global usings would clash with WPF names. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
