<UserControl x:Class="Zarpazo.Settings.HotKeyPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="Box" Width="220" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp" />
            <Button Content="Restablecer" Margin="8,0,0,0" Click="OnReset" />
        </StackPanel>
        <TextBlock x:Name="Hint" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
