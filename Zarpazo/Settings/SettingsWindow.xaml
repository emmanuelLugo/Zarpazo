<Window x:Class="Zarpazo.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Zarpazo"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aceptar" IsDefault="True" Click="OnAccept" Margin="0,0,8,0" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="14,0,14,14">
                    <TextBlock Style="{StaticResource Section}" Text="Inicio" />
                    <CheckBox x:Name="StartupBox" Content="Iniciar Zarpazo con Windows" />

                    <TextBlock Style="{StaticResource Section}" Text="Atajo de captura" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HotKeyBox" Width="220" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Padding="4,3" PreviewKeyDown="OnHotKeyKeyDown" PreviewKeyUp="OnHotKeyKeyUp" />
                        <Button Content="Restablecer" Margin="8,0,0,0" Click="OnResetHotKey" />
                    </StackPanel>
                    <TextBlock x:Name="HotKeyHint" Style="{StaticResource Hint}" />

                    <TextBlock Style="{StaticResource Section}" Text="Copiar" />
                    <CheckBox x:Name="CopyAsFileBox" Content="Copiar también como archivo PNG" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Permite pegar la ruta de la captura en una terminal como el cmd. Si alguna aplicación pega un archivo en vez de la imagen, desactívalo." />

                    <TextBlock Style="{StaticResource Section}" Text="Guardar" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Padding="4,3" />
                        <Button Grid.Column="1" Content="Examinar…" Margin="8,0,0,0" Click="OnBrowseFolder" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Carpeta donde se abre el cuadro de guardar. Vacía usa Imágenes." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Formato por defecto" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="FormatBox" Width="80">
                            <ComboBoxItem Content="PNG" />
                            <ComboBoxItem Content="JPG" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Herramientas" />
                    <CheckBox x:Name="RememberStyleBox" Content="Recordar el último color y grosor" />

                    <TextBlock Style="{StaticResource Section}" Text="Historial" />
                    <CheckBox x:Name="KeepHistoryBox" Content="Guardar un historial de las capturas" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Guarda en este equipo las últimas 100 capturas que copias o guardas, para volver a usarlas desde el icono de la bandeja. Al desactivarlo no se borra lo ya guardado." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Acerca de">
                <StackPanel Margin="14">
                    <TextBlock Text="Zarpazo" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="#FF666666" Margin="0,2,0,0" />
                    <TextBlock Text="Desarrollado por provisorio43" Foreground="#FF666666" Margin="0,2,0,12" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Capturas de pantalla rápidas para Windows, con anotaciones, regla y cuentagotas." />

                    <TextBlock Style="{StaticResource Section}" Text="Tu configuración" />
                    <TextBlock x:Name="SettingsPathText" TextWrapping="Wrap" />
                    <Button Content="Abrir carpeta" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnOpenSettingsFolder" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
