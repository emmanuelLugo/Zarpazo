<Window x:Class="Zarpazo.Guide.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturas agrupadas"
        Width="560"
        Height="560"
        MinWidth="440"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16,14,16,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
            </StackPanel.Resources>
            <Button x:Name="CopyButton" Content="Copiar todas" Click="OnCopyImages"
                    ToolTip="Copia todas las capturas como archivos: al pegar en WhatsApp, Teams o un correo se adjuntan todas de una vez" />
            <Button x:Name="ClearButton" Content="Vaciar" Click="OnClear" ToolTip="Quita todas las capturas del grupo" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <Grid>
            <ListBox x:Name="Items"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Thumbnail}" Width="220" Stretch="Uniform" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Heading}" FontWeight="SemiBold" Margin="12,0" />
                            <StackPanel Grid.Column="2">
                                <Button Content="↑" Width="30" Margin="0,0,0,4" ToolTip="Subir" Click="OnMoveUp" />
                                <Button Content="↓" Width="30" Margin="0,0,0,4" ToolTip="Bajar" Click="OnMoveDown" />
                                <Button Content="✕" Width="30" ToolTip="Quitar esta captura" Click="OnRemove" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="No hay capturas en el grupo. Captura una zona y, en el menú ··· del editor, elige &quot;Añadir al grupo&quot; (Ctrl+D). Repítelo con cada pantalla y luego copia todas de una vez." />
        </Grid>
    </DockPanel>
</Window>
