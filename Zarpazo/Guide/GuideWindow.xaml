<Window x:Class="Zarpazo.Guide.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturas agrupadas"
        Width="600"
        Height="580"
        MinWidth="500"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16,14,16,16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="CopyButton" Content="Copiar todas" Click="OnCopyFiles"
                        ToolTip="Copia las capturas como archivos: al pegar en WhatsApp, Teams o un correo se adjuntan todas de una vez" />
                <Button x:Name="CopyOneButton" Content="Copiar como una imagen" Click="OnCopyOne"
                        ToolTip="Las junta en una sola imagen, una debajo de otra: se pega en cualquier programa" />
                <Border x:Name="DragAll" Padding="10,4" CornerRadius="4" Margin="0,0,8,0" Cursor="Hand"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        ToolTip="Arrastra desde aquí hacia un chat o un correo abierto para soltar todas las capturas"
                        PreviewMouseLeftButtonDown="OnDragAllDown" PreviewMouseMove="OnDragAllMove">
                    <TextBlock Text="⠿ Arrastrar todas" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="ClearButton" Content="Vaciar" Click="OnClear" ToolTip="Quita todas las capturas del grupo" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <CheckBox x:Name="ModeBox" Content="Modo grupo: Enter añade la captura al grupo" Click="OnModeClicked"
                      ToolTip="Mientras esté activo, terminar una captura con Enter la suma a este grupo en vez de copiarla (Ctrl+C sigue copiando). Se apaga al cerrar Zarpazo." />
            <TextBlock x:Name="HotKeyHint" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid>
            <ListBox x:Name="Items"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="OnItemsDown"
                     PreviewMouseMove="OnItemsMove">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Thumbnail}" Width="220" Stretch="Uniform" VerticalAlignment="Top"
                                   ToolTip="Arrástrala a un chat o un correo para soltar solo esta captura" />
                            <TextBlock Grid.Column="1" Text="{Binding Heading}" FontWeight="SemiBold" Margin="12,0" />
                            <StackPanel Grid.Column="2">
                                <Button Content="↑" Width="30" Margin="0,0,0,4" ToolTip="Subir" Click="OnMoveUp" />
                                <Button Content="↓" Width="30" Margin="0,0,0,4" ToolTip="Bajar" Click="OnMoveDown" />
                                <Button Content="✕" Width="30" ToolTip="Quitar esta captura" Click="OnRemove" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="No hay capturas en el grupo. Activa el modo grupo, o elige &quot;Añadir al grupo&quot; (Ctrl+D) en el menú ··· del editor. Cuando termines, copia todas de una vez." />
        </Grid>
    </DockPanel>
</Window>
