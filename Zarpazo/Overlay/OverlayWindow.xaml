<Window x:Class="Zarpazo.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Zarpazo.Editor"
        xmlns:local="clr-namespace:Zarpazo.Overlay"
        Title="Zarpazo"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black">
    <Grid>
        <Image x:Name="Screenshot"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Path Fill="#80000000" RenderOptions.EdgeMode="Aliased">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="DimArea" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="Selection" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <editor:AnnotationCanvas x:Name="Annotations"
                                 IsHitTestVisible="False"
                                 RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Path x:Name="SelectionBorder"
              Stroke="White"
              StrokeThickness="1"
              RenderOptions.EdgeMode="Aliased" />

        <Path x:Name="Handles"
              Fill="White"
              Stroke="#FF404040"
              StrokeThickness="1"
              IsHitTestVisible="False"
              Visibility="Collapsed" />

        <Canvas x:Name="UiLayer">
            <!-- Follows the pointer with the size of the next mark; the mouse wheel changes it. -->
            <Ellipse x:Name="SizeBubbleRing"
                     Stroke="#99000000"
                     StrokeThickness="1"
                     IsHitTestVisible="False"
                     Visibility="Collapsed" />
            <Ellipse x:Name="SizeBubble"
                     Stroke="#F2FFFFFF"
                     StrokeThickness="1"
                     IsHitTestVisible="False"
                     Visibility="Collapsed" />

            <Border x:Name="SizeValue"
                    Background="#CC000000"
                    CornerRadius="3"
                    Padding="6,2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeValueText" Foreground="White" FontFamily="Consolas" FontSize="12" />
            </Border>

            <editor:EditorToolbar x:Name="Toolbar"
                                  Visibility="Collapsed"
                                  UndoRequested="OnUndo"
                                  RedoRequested="OnRedo"
                                  CopyRequested="OnCopy"
                                  SaveRequested="OnSave"
                                  OcrRequested="OnOcr"
                                  PinRequested="OnPin"
                                  GuideRequested="OnGuide"
                                  RecordRequested="OnRecord"
                                  CloseRequested="OnCloseRequested" />

            <Border x:Name="SizeLabel"
                    Background="#CC000000"
                    CornerRadius="3"
                    Padding="6,2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontFamily="Consolas" FontSize="12" />
            </Border>

            <Border x:Name="GroupBadge"
                    Background="#E6202124"
                    CornerRadius="6"
                    Padding="12,6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="GroupBadgeText" Foreground="#FDD835" FontFamily="Segoe UI" FontSize="14" />
            </Border>

            <Border x:Name="Notice"
                    Background="#E6202124"
                    CornerRadius="6"
                    Padding="12,6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" Foreground="White" FontFamily="Segoe UI" FontSize="14" />
            </Border>

            <local:Magnifier x:Name="Probe" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
