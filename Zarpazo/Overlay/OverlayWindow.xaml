<Window x:Class="Zarpazo.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Zarpazo.Editor"
        Title="Zarpazo"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross">
    <Grid>
        <Image x:Name="Screenshot"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Path Fill="#80000000" RenderOptions.EdgeMode="Aliased">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="DimArea" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="Selection" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <editor:AnnotationCanvas x:Name="Annotations" IsHitTestVisible="False" />

        <Path x:Name="SelectionBorder"
              Stroke="White"
              StrokeThickness="1"
              RenderOptions.EdgeMode="Aliased" />

        <Canvas x:Name="UiLayer">
            <editor:EditorToolbar x:Name="Toolbar"
                                  Visibility="Collapsed"
                                  UndoRequested="OnUndo"
                                  RedoRequested="OnRedo"
                                  CopyRequested="OnCopy"
                                  SaveRequested="OnSave" />
        </Canvas>
    </Grid>
</Window>
