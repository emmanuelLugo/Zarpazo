<UserControl x:Class="Zarpazo.Overlay.Magnifier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border Background="#F0262626" CornerRadius="6" Padding="6">
        <StackPanel Width="132">
            <Grid Width="132" Height="132">
                <Image x:Name="Zoom" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <!-- Two outlines so the pixel under the cursor shows on both light and dark colors. -->
                <Rectangle Width="12" Height="12" Stroke="Black" StrokeThickness="1" />
                <Rectangle Width="10" Height="10" Stroke="White" StrokeThickness="1" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse x:Name="Swatch" Width="16" Height="16" Stroke="#88FFFFFF" StrokeThickness="1" />
                <TextBlock x:Name="Value" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="White" FontFamily="Consolas" FontSize="13" />
            </StackPanel>
            <TextBlock x:Name="Hint" Margin="0,4,0,0" Foreground="#AAFFFFFF" FontSize="11" />
        </StackPanel>
    </Border>
</UserControl>
