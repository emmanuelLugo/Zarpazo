<Window x:Class="Zarpazo.Pin.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarpazo"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Rueda del mouse: opacidad" IsEnabled="False" />
            <Separator />
            <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="OnCopy" />
            <MenuItem Header="Guardar como…" Click="OnSave" />
            <Separator />
            <MenuItem Header="Cerrar" InputGestureText="Esc" Click="OnClose" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Two outlines, so the edge shows over both light and dark content. -->
        <Border BorderBrush="#99000000" BorderThickness="1" IsHitTestVisible="False" />
        <Border BorderBrush="#66FFFFFF" BorderThickness="1" Margin="1" IsHitTestVisible="False" />

        <Button x:Name="CloseButton"
                Width="22" Height="22" Margin="6"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed" Focusable="False"
                ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar"
                Click="OnClose">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Disc" CornerRadius="11" Background="#E6202124" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <Path Data="M7,7 L15,15 M15,7 L7,15" Stroke="White" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Margin="-1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="#E6E53935" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
