<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Dark.xaml: the windows refer to them with DynamicResource, so swapping the dictionary restyles everything. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Hover" Color="#FFEBEEF2" />
    <SolidColorBrush x:Key="Pressed" Color="#FFDDE1E7" />
    <SolidColorBrush x:Key="Border" Color="#FFD8DCE2" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FFB4BAC4" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1F2328" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF667080" />
    <SolidColorBrush x:Key="TextDisabled" Color="#FFA0A7B2" />
    <SolidColorBrush x:Key="Accent" Color="#FFE53935" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFD32F2F" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FFB71C1C" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#FFFDEBEA" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#FFC3C8D0" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF9AA1AD" />
</ResourceDictionary>
