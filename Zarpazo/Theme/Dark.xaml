<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Light.xaml. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1B1C1F" />
    <SolidColorBrush x:Key="Surface" Color="#FF26272B" />
    <SolidColorBrush x:Key="InputBackground" Color="#FF1F2023" />
    <SolidColorBrush x:Key="Hover" Color="#FF303237" />
    <SolidColorBrush x:Key="Pressed" Color="#FF3B3E44" />
    <SolidColorBrush x:Key="Border" Color="#FF3A3D43" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FF5A5E67" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9BA1AA" />
    <SolidColorBrush x:Key="TextDisabled" Color="#FF6A6F78" />
    <SolidColorBrush x:Key="Accent" Color="#FFEF5350" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFF47573" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FFD94441" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#FF3A2527" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF4A4D55" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF6C707A" />
</ResourceDictionary>
