<UserControl x:Class="Zarpazo.Editor.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Arrow">
    <UserControl.Resources>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnChoicePressed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" MinWidth="30" Height="30" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" MinWidth="30" Height="30" Padding="8,0" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="5,4" />
            <Setter Property="Background" Value="#44FFFFFF" />
        </Style>
    </UserControl.Resources>

    <Border Background="#F0262626" CornerRadius="6" Padding="4">
        <StackPanel Orientation="Horizontal" RadioButton.Checked="OnChoice">
            <RadioButton x:Name="SelectTool" GroupName="tool" Tag="Select" IsChecked="True" Style="{StaticResource Choice}"
                         Content="⛶" ToolTip="Ajustar la zona: arrastra las asas o el interior. Arrastrar fuera elige otra zona y borra las anotaciones" />
            <RadioButton GroupName="tool" Tag="Move" Style="{StaticResource Choice}"
                         Content="✥" ToolTip="Mover anotaciones (Supr borra la seleccionada)" />
            <RadioButton GroupName="tool" Tag="Rectangle" Style="{StaticResource Choice}"
                         Content="▭" ToolTip="Rectángulo" />
            <RadioButton GroupName="tool" Tag="Ellipse" Style="{StaticResource Choice}"
                         Content="◯" ToolTip="Elipse" />
            <RadioButton GroupName="tool" Tag="Line" Style="{StaticResource Choice}"
                         Content="╱" ToolTip="Línea" />
            <RadioButton GroupName="tool" Tag="Arrow" Style="{StaticResource Choice}"
                         Content="➚" ToolTip="Flecha" />
            <RadioButton GroupName="tool" Tag="Pen" Style="{StaticResource Choice}"
                         Content="✎" ToolTip="Lápiz" />
            <RadioButton GroupName="tool" Tag="Highlighter" Style="{StaticResource Choice}"
                         ToolTip="Resaltador">
                <Rectangle Width="16" Height="9" Fill="#B3FDD835" Stroke="#88FFFFFF" StrokeThickness="1" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Text" Style="{StaticResource Choice}"
                         Content="T" FontWeight="Bold" ToolTip="Texto (Enter confirma, Mayús+Enter salto de línea)" />
            <RadioButton GroupName="tool" Tag="Step" Style="{StaticResource Choice}"
                         ToolTip="Numeración de pasos (un clic por número)">
                <Grid>
                    <Ellipse Width="18" Height="18" Fill="White" />
                    <TextBlock Text="1" Foreground="Black" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Pixelate" Style="{StaticResource Choice}"
                         Content="▦" ToolTip="Pixelar para ocultar datos" />
            <RadioButton GroupName="tool" Tag="Ruler" Style="{StaticResource Choice}"
                         Content="↔" ToolTip="Regla: mide una distancia en píxeles" />
            <RadioButton GroupName="tool" Tag="Picker" Style="{StaticResource Choice}"
                         Content="💧" ToolTip="Cuentagotas: clic copia el color, X cambia entre HEX y RGB" />

            <Border Style="{StaticResource Divider}" />

            <!-- Color and thickness are one button each showing the current choice; the options live in popups so they
                 don't take bar space. -->
            <Button x:Name="ColorButton" Style="{StaticResource Action}" ToolTip="Color" Click="OnColorButton">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ColorSwatch" Width="16" Height="16" Fill="#E53935" Stroke="#88FFFFFF" StrokeThickness="1" />
                    <TextBlock Text="▾" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Popup x:Name="ColorPopup"
                   PlacementTarget="{Binding ElementName=ColorButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F0262626" CornerRadius="6" Padding="4" Margin="0,0,0,6">
                    <StackPanel RadioButton.Checked="OnChoice">
                        <WrapPanel Width="198">
                            <RadioButton GroupName="color" Tag="#E53935" IsChecked="True" Style="{StaticResource Choice}" ToolTip="Rojo">
                                <Ellipse Width="16" Height="16" Fill="#E53935" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FB8C00" Style="{StaticResource Choice}" ToolTip="Naranja">
                                <Ellipse Width="16" Height="16" Fill="#FB8C00" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FDD835" Style="{StaticResource Choice}" ToolTip="Amarillo">
                                <Ellipse Width="16" Height="16" Fill="#FDD835" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#43A047" Style="{StaticResource Choice}" ToolTip="Verde">
                                <Ellipse Width="16" Height="16" Fill="#43A047" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#00ACC1" Style="{StaticResource Choice}" ToolTip="Turquesa">
                                <Ellipse Width="16" Height="16" Fill="#00ACC1" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#1E88E5" Style="{StaticResource Choice}" ToolTip="Azul">
                                <Ellipse Width="16" Height="16" Fill="#1E88E5" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#8E24AA" Style="{StaticResource Choice}" ToolTip="Morado">
                                <Ellipse Width="16" Height="16" Fill="#8E24AA" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#EC407A" Style="{StaticResource Choice}" ToolTip="Rosa">
                                <Ellipse Width="16" Height="16" Fill="#EC407A" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#6D4C41" Style="{StaticResource Choice}" ToolTip="Marrón">
                                <Ellipse Width="16" Height="16" Fill="#6D4C41" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#9E9E9E" Style="{StaticResource Choice}" ToolTip="Gris">
                                <Ellipse Width="16" Height="16" Fill="#9E9E9E" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#000000" Style="{StaticResource Choice}" ToolTip="Negro">
                                <Ellipse Width="16" Height="16" Fill="#000000" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FFFFFF" Style="{StaticResource Choice}" ToolTip="Blanco">
                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <!-- Appears after a custom color has been picked, so the choice shows up in the grid. -->
                            <RadioButton x:Name="CustomChoice" GroupName="color" Tag="#000000" Visibility="Collapsed"
                                         Style="{StaticResource Choice}" ToolTip="Color personalizado">
                                <Ellipse x:Name="CustomDot" Width="16" Height="16" Fill="Black" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                        </WrapPanel>
                        <Button Style="{StaticResource Action}" Content="Personalizado…" Margin="1,4,1,0" Click="OnCustomColor" />
                    </StackPanel>
                </Border>
            </Popup>

            <Button x:Name="SizeButton" Style="{StaticResource Action}" ToolTip="Grosor (y tamaño del texto)" Click="OnSizeButton">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16">
                        <Ellipse x:Name="SizeSwatch" Width="8" Height="8" Fill="White" />
                    </Grid>
                    <TextBlock Text="▾" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Popup x:Name="SizePopup"
                   PlacementTarget="{Binding ElementName=SizeButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F0262626" CornerRadius="6" Padding="4" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" RadioButton.Checked="OnChoice">
                        <RadioButton GroupName="size" Tag="2" Style="{StaticResource Choice}" ToolTip="Fino">
                            <Ellipse Width="4" Height="4" Fill="White" />
                        </RadioButton>
                        <RadioButton GroupName="size" Tag="4" IsChecked="True" Style="{StaticResource Choice}" ToolTip="Medio">
                            <Ellipse Width="8" Height="8" Fill="White" />
                        </RadioButton>
                        <RadioButton GroupName="size" Tag="8" Style="{StaticResource Choice}" ToolTip="Grueso">
                            <Ellipse Width="13" Height="13" Fill="White" />
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Popup>

            <Border Style="{StaticResource Divider}" />

            <Button Style="{StaticResource Action}" Content="↶" ToolTip="Deshacer (Ctrl+Z)" Click="OnUndo" />
            <Button Style="{StaticResource Action}" Content="↷" ToolTip="Rehacer (Ctrl+Y)" Click="OnRedo" />

            <Border Style="{StaticResource Divider}" />

            <Button Style="{StaticResource Action}" Content="Copiar" ToolTip="Copiar al portapapeles (Enter)" Click="OnCopy" />
            <Button Style="{StaticResource Action}" Content="Guardar" ToolTip="Guardar como imagen (Ctrl+S)" Click="OnSave" />
        </StackPanel>
    </Border>
</UserControl>
