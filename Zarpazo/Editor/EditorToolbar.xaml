<UserControl x:Class="Zarpazo.Editor.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Arrow">
    <UserControl.Resources>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnChoicePressed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" MinWidth="32" Height="32" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" MinWidth="32" Height="32" Padding="8,0" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAFFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,10,0,3" />
        </Style>

        <Style x:Key="Bar" TargetType="Border">
            <Setter Property="Background" Value="#F2202124" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DividerH" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>

        <!-- Every icon is drawn on a 16 x 16 grid with the same stroke, so they read as one set. -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Path x:Key="IconRectangle" x:Shared="False" Style="{StaticResource Icon}" Data="M2.5,3.5 H13.5 V12.5 H2.5 Z" />
        <Path x:Key="IconEllipse" x:Shared="False" Style="{StaticResource Icon}" Data="M2,8 A6,5 0 1 0 14,8 A6,5 0 1 0 2,8 Z" />
        <Path x:Key="IconLine" x:Shared="False" Style="{StaticResource Icon}" Data="M3,13 L13,3" />
        <Path x:Key="IconArrow" x:Shared="False" Style="{StaticResource Icon}" Data="M3,13 L13,3 M6.5,3 H13 V9.5" />
        <Path x:Key="IconPen" x:Shared="False" Style="{StaticResource Icon}" Data="M2.5,13.5 L3.3,10 L10.8,2.5 L13.5,5.2 L6,12.7 Z M9.2,4.1 L11.9,6.8" />
        <Grid x:Key="IconHighlighter" x:Shared="False" Width="16" Height="16">
            <Path Style="{StaticResource Icon}" Data="M10.5,1.8 L13.7,5 L7.2,11.5 L4,8.3 Z M4,8.3 L2.5,11.7 L6,10.5" />
            <Path Style="{StaticResource Icon}" Data="M8,14.2 H14" Stroke="#FDD835" StrokeThickness="2" />
        </Grid>
        <Path x:Key="IconRuler" x:Shared="False" Style="{StaticResource Icon}" Data="M1.5,5.5 H14.5 V10.5 H1.5 Z M4.5,5.5 V8 M8,5.5 V8.5 M11.5,5.5 V8" />
        <Path x:Key="IconPicker" x:Shared="False" Style="{StaticResource Icon}"
              Data="M2.5,13.5 L3.2,10.3 L9.3,4.2 L11.8,6.7 L5.7,12.8 Z M8.5,5 L11,2.5 Q12.5,1 14,2.5 Q15.5,4 13.5,5.5 L11.5,7.5" />

        <!-- A row of a pop-up list: a tool with its name. -->
        <Style x:Key="MenuChoice" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnChoicePressed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" MinWidth="150" Height="32" Padding="8,0" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuAction" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Height="32" Padding="8,0" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Two bars on a transparent layer the size of the screen: the drawing tools stand beside the area, the actions under it.
         Where each goes is worked out in Place, so neither covers the other or leaves the screen. -->
    <Canvas x:Name="Layer" RadioButton.Checked="OnChoice">
    <Border x:Name="ToolsBar" Style="{StaticResource Bar}">
        <StackPanel Orientation="Vertical">
            <!-- "Adjust the area" has no button: pressing the active tool again, or its entry in a group, goes back to it. -->
            <RadioButton x:Name="SelectTool" GroupName="tool" Tag="Select" IsChecked="True" Style="{StaticResource Choice}"
                         Visibility="Collapsed" AutomationProperties.Name="Ajustar zona" />
            <RadioButton GroupName="tool" Tag="Move" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Mover anotaciones"
                         ToolTip="Mover y estirar anotaciones (V). Supr borra la seleccionada">
                <Path Style="{StaticResource Icon}"
                      Data="M8,1.5 V14.5 M1.5,8 H14.5 M6,3.5 L8,1.5 L10,3.5 M6,12.5 L8,14.5 L10,12.5 M3.5,6 L1.5,8 L3.5,10 M12.5,6 L14.5,8 L12.5,10" />
            </RadioButton>

            <Border Style="{StaticResource DividerH}" />

            <!-- Tools that belong together share one button showing the one used last; the groups are built in code. -->
            <ContentControl x:Name="ShapesSlot" Focusable="False" IsTabStop="False" />
            <ContentControl x:Name="DrawSlot" Focusable="False" IsTabStop="False" />
            <RadioButton GroupName="tool" Tag="Text" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Texto" ToolTip="Texto (T). Enter confirma, Mayús+Enter salto de línea">
                <Path Style="{StaticResource Icon}" Data="M3,4 V3 H13 V4 M8,3 V13 M6,13 H10" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Step" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Numeración de pasos" ToolTip="Numeración de pasos (N): un clic por número">
                <Grid Width="16" Height="16">
                    <Ellipse Margin="0.75" Stroke="White" StrokeThickness="1.5" />
                    <TextBlock Text="1" Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Pixelate" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Pixelar" ToolTip="Pixelar para ocultar datos (B)">
                <Grid Width="16" Height="16">
                    <Path Style="{StaticResource Icon}" StrokeThickness="0" Fill="#99FFFFFF"
                          Data="M2,2 H8 V8 H2 Z M8,8 H14 V14 H8 Z" />
                    <Path Style="{StaticResource Icon}" Data="M2.5,2.5 H13.5 V13.5 H2.5 Z M8,2.5 V13.5 M2.5,8 H13.5" />
                </Grid>
            </RadioButton>
            <ContentControl x:Name="MeasureSlot" Focusable="False" IsTabStop="False" />

            <!-- Only for the tools that draw something with a color. -->
            <StackPanel x:Name="StyleTools" Visibility="Collapsed">
                <Border Style="{StaticResource DividerH}" />

            <!-- Color and thickness are one button each showing the current choice; the options live in popups so they
                 don't take bar space. -->
            <Button x:Name="ColorButton" Style="{StaticResource Action}" ToolTip="Color" AutomationProperties.Name="Color" Click="OnColorButton">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ColorSwatch" Width="16" Height="16" Fill="#E53935" Stroke="#88FFFFFF" StrokeThickness="1" />
                </StackPanel>
            </Button>
            <Popup x:Name="ColorPopup"
                   PlacementTarget="{Binding ElementName=ColorButton}"
                   Placement="Right"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F2202124" CornerRadius="8" Padding="4" Margin="6">
                    <StackPanel RadioButton.Checked="OnChoice">
                        <WrapPanel Width="204">
                            <RadioButton GroupName="color" Tag="#E53935" IsChecked="True" Style="{StaticResource Choice}" ToolTip="Rojo">
                                <Ellipse Width="16" Height="16" Fill="#E53935" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FB8C00" Style="{StaticResource Choice}" ToolTip="Naranja">
                                <Ellipse Width="16" Height="16" Fill="#FB8C00" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FDD835" Style="{StaticResource Choice}" ToolTip="Amarillo">
                                <Ellipse Width="16" Height="16" Fill="#FDD835" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#43A047" Style="{StaticResource Choice}" ToolTip="Verde">
                                <Ellipse Width="16" Height="16" Fill="#43A047" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#00ACC1" Style="{StaticResource Choice}" ToolTip="Turquesa">
                                <Ellipse Width="16" Height="16" Fill="#00ACC1" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#1E88E5" Style="{StaticResource Choice}" ToolTip="Azul">
                                <Ellipse Width="16" Height="16" Fill="#1E88E5" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#8E24AA" Style="{StaticResource Choice}" ToolTip="Morado">
                                <Ellipse Width="16" Height="16" Fill="#8E24AA" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#EC407A" Style="{StaticResource Choice}" ToolTip="Rosa">
                                <Ellipse Width="16" Height="16" Fill="#EC407A" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#6D4C41" Style="{StaticResource Choice}" ToolTip="Marrón">
                                <Ellipse Width="16" Height="16" Fill="#6D4C41" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#9E9E9E" Style="{StaticResource Choice}" ToolTip="Gris">
                                <Ellipse Width="16" Height="16" Fill="#9E9E9E" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#000000" Style="{StaticResource Choice}" ToolTip="Negro">
                                <Ellipse Width="16" Height="16" Fill="#000000" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FFFFFF" Style="{StaticResource Choice}" ToolTip="Blanco">
                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <!-- Appears after a custom color has been picked, so the choice shows up in the grid. -->
                            <RadioButton x:Name="CustomChoice" GroupName="color" Tag="#000000" Visibility="Collapsed"
                                         Style="{StaticResource Choice}" ToolTip="Color personalizado">
                                <Ellipse x:Name="CustomDot" Width="16" Height="16" Fill="Black" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                        </WrapPanel>
                        <Button Style="{StaticResource Action}" Content="Personalizado…" Margin="1,4,1,0" Click="OnCustomColor" />
                    </StackPanel>
                </Border>
            </Popup>

            <Button x:Name="SizeButton" Style="{StaticResource Action}" ToolTip="Grosor (y tamaño del texto)"
                    AutomationProperties.Name="Grosor" Click="OnSizeButton">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16">
                        <Ellipse x:Name="SizeSwatch" Width="8" Height="8" Fill="White" />
                    </Grid>
                </StackPanel>
            </Button>
            <Popup x:Name="SizePopup"
                   PlacementTarget="{Binding ElementName=SizeButton}"
                   Placement="Right"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F2202124" CornerRadius="8" Padding="4" Margin="6">
                    <StackPanel Orientation="Horizontal" RadioButton.Checked="OnChoice">
                        <RadioButton GroupName="size" Tag="2" Style="{StaticResource Choice}" ToolTip="Fino">
                            <Ellipse Width="4" Height="4" Fill="White" />
                        </RadioButton>
                        <RadioButton GroupName="size" Tag="4" IsChecked="True" Style="{StaticResource Choice}" ToolTip="Medio">
                            <Ellipse Width="8" Height="8" Fill="White" />
                        </RadioButton>
                        <RadioButton GroupName="size" Tag="8" Style="{StaticResource Choice}" ToolTip="Grueso">
                            <Ellipse Width="13" Height="13" Fill="White" />
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Popup>

            </StackPanel>
        </StackPanel>
    </Border>

    <Border x:Name="ActionsBar" Style="{StaticResource Bar}">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Action}" ToolTip="Deshacer (Ctrl+Z)" AutomationProperties.Name="Deshacer" Click="OnUndo">
                <Path Style="{StaticResource Icon}" Data="M5,3 L2,6 L5,9 M2,6 H9.5 A3.5,3.5 0 0 1 9.5,13 H6" />
            </Button>
            <Button Style="{StaticResource Action}" ToolTip="Rehacer (Ctrl+Y)" AutomationProperties.Name="Rehacer" Click="OnRedo">
                <Path Style="{StaticResource Icon}" Data="M11,3 L14,6 L11,9 M14,6 H6.5 A3.5,3.5 0 0 0 6.5,13 H10" />
            </Button>

            <Border Style="{StaticResource Divider}" />

            <Button x:Name="RecordButton" Style="{StaticResource Action}" ToolTip="Grabar esta zona como GIF o video, con o sin sonido (Ctrl+G empieza con lo último elegido)"
                    AutomationProperties.Name="Grabar" Click="OnRecordButton">
                <Grid Width="16" Height="16">
                    <Ellipse Margin="1.5" Stroke="#EF5350" StrokeThickness="1.5" />
                    <Ellipse Margin="5" Fill="#EF5350" />
                </Grid>
            </Button>
            <Popup x:Name="RecordPopup"
                   PlacementTarget="{Binding ElementName=RecordButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   Opened="OnRecordPopupOpened"
                   Closed="OnRecordPopupClosed">
                <Border Background="#F2202124" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                    <StackPanel Width="250" RadioButton.Checked="OnRecordChoice">
                        <TextBlock Text="Formato" Style="{StaticResource PanelLabel}" Margin="2,0,0,3" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RecordGifChoice" GroupName="recordFormat" Tag="gif" Style="{StaticResource Choice}"
                                         ToolTip="Imagen animada, sin sonido, hasta 30 segundos">
                                <TextBlock Text="GIF" Margin="10,0" />
                            </RadioButton>
                            <RadioButton x:Name="RecordVideoChoice" GroupName="recordFormat" Tag="video" Style="{StaticResource Choice}"
                                         ToolTip="Video MP4 con sonido opcional, hasta 30 minutos">
                                <TextBlock Text="Video MP4" Margin="10,0" />
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Sonido (solo en video)" Style="{StaticResource PanelLabel}" />
                        <CheckBox x:Name="RecordMicrophoneBox" Content="Micrófono" Foreground="White" FontFamily="Segoe UI" FontSize="13"
                                  Focusable="False" Click="OnRecordMicrophone" />
                        <ComboBox x:Name="RecordMicrophoneList" Margin="20,4,0,2" FontFamily="Segoe UI" FontSize="12"
                                  DisplayMemberPath="Name" SelectionChanged="OnRecordMicrophoneChosen"
                                  ToolTip="El micrófono que se graba. 'Predeterminado de Windows' usa el que Windows tenga elegido." />
                        <Border x:Name="MicrophoneLevelTrack" Height="8" Margin="20,4,0,0" CornerRadius="4" Background="#33FFFFFF"
                                ToolTip="Nivel del micrófono: si habla alguien y la barra se mueve, se está grabando">
                            <Border x:Name="MicrophoneLevelFill" Width="0" CornerRadius="4" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="MicrophoneLevelHint" Margin="20,2,0,0" Foreground="#B3FFFFFF" FontFamily="Segoe UI" FontSize="11"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="RecordSystemSoundBox" Content="Sonido de Windows" ToolTip="Lo que suena por tus altavoces o auriculares: música, videollamadas, el propio video que veas" Foreground="White" FontFamily="Segoe UI" FontSize="13"
                                  Margin="0,6,0,0" Focusable="False" Click="OnRecordSystemSound" />
                        <ComboBox x:Name="RecordSpeakersList" Margin="20,4,0,2" FontFamily="Segoe UI" FontSize="12"
                                  DisplayMemberPath="Name" SelectionChanged="OnRecordSpeakersChosen"
                                  ToolTip="De qué altavoces o auriculares se toma el sonido. 'Predeterminado de Windows' usa los que Windows tenga elegidos." />
                        <Border x:Name="SpeakersLevelTrack" Height="8" Margin="20,4,0,0" CornerRadius="4" Background="#33FFFFFF"
                                ToolTip="Nivel del sonido de Windows: se mueve cuando suena algo por tus altavoces o auriculares">
                            <Border x:Name="SpeakersLevelFill" Width="0" CornerRadius="4" HorizontalAlignment="Left" />
                        </Border>

                        <TextBlock Text="Efectos (GIF y video)" Style="{StaticResource PanelLabel}" />
                        <CheckBox x:Name="RecordHighlightBox" Content="Resaltar el cursor y los clics" Foreground="White" FontFamily="Segoe UI" FontSize="13"
                                  ToolTip="Un halo alrededor del puntero y un anillo en cada clic, para que se siga mejor lo que haces"
                                  Focusable="False" Click="OnRecordHighlight" />
                        <CheckBox x:Name="RecordKeysBox" Content="Mostrar atajos de teclado" Foreground="White" FontFamily="Segoe UI" FontSize="13"
                                  ToolTip="Muestra Ctrl+C, Alt+Tab, Enter, F5… Nunca muestra las letras que escribes, para que una contraseña no quede a la vista"
                                  Margin="0,6,0,0" Focusable="False" Click="OnRecordKeys" />

                        <Button Margin="0,12,0,0" Focusable="False" Click="OnRecordStart" AutomationProperties.Name="Empezar a grabar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Height="32" CornerRadius="6" Background="#E53935">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,8,0" />
                                            <TextBlock Text="Empezar a grabar" Foreground="White" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="#EF5350" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Button x:Name="MoreButton" Style="{StaticResource Action}" ToolTip="Más: copiar el texto, fijar sobre la pantalla, embellecer"
                    AutomationProperties.Name="Más" Click="OnMoreButton">
                <Grid Width="16" Height="16">
                    <Path Fill="White" Data="M2.2,8 A1.3,1.3 0 1 0 4.8,8 A1.3,1.3 0 1 0 2.2,8 Z M6.7,8 A1.3,1.3 0 1 0 9.3,8 A1.3,1.3 0 1 0 6.7,8 Z M11.2,8 A1.3,1.3 0 1 0 13.8,8 A1.3,1.3 0 1 0 11.2,8 Z" />
                    <!-- Shows when Embellecer is on, so a forgotten setting doesn't surprise anyone. -->
                    <Ellipse x:Name="BeautifyDot" Width="7" Height="7" Fill="#FDD835" Stroke="#F2202124" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Popup x:Name="MorePopup"
                   PlacementTarget="{Binding ElementName=MoreButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F2202124" CornerRadius="8" Padding="4" Margin="0,0,0,6">
                    <StackPanel Width="264">
                        <Button Style="{StaticResource MenuAction}" Click="OnMoreOcr" AutomationProperties.Name="Copiar texto"
                                ToolTip="Lee el texto de la zona y lo copia">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource Icon}" Data="M1.5,5 V1.5 H5 M11,1.5 H14.5 V5 M14.5,11 V14.5 H11 M5,14.5 H1.5 V11 M5,5.5 H11 M8,5.5 V11" />
                                <TextBlock Grid.Column="1" Text="Copiar texto de la imagen" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="Ctrl+T" Foreground="#80FFFFFF" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuAction}" Click="OnMorePin" AutomationProperties.Name="Fijar"
                                ToolTip="Deja la captura flotando sobre la pantalla">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource Icon}" Data="M9,2.5 L13.5,7 L11.5,8 L8.5,11 L8,13 L3,8 L5,7.5 L8,4.5 Z M5.5,10.5 L2,14" />
                                <TextBlock Grid.Column="1" Text="Fijar sobre la pantalla" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="Ctrl+P" Foreground="#80FFFFFF" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuAction}" Click="OnMoreGuide" AutomationProperties.Name="Añadir al grupo"
                                ToolTip="Suma la captura a un grupo para copiar varias de una vez (abre el grupo desde el icono de la bandeja)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource Icon}" Data="M3,2.5 H13 V13.5 H3 Z M5.5,6 H10.5 M5.5,8.5 H10.5 M5.5,11 H8.5" />
                                <TextBlock Grid.Column="1" Text="Añadir al grupo" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="Ctrl+D" Foreground="#80FFFFFF" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuAction}" Click="OnMoreBeautify" AutomationProperties.Name="Embellecer"
                                ToolTip="Fondo, margen, esquinas y sombra al copiar y guardar">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource Icon}" Data="M2,2.5 H14 V13.5 H2 Z M5.5,5.5 H10.5 V10.5 H5.5 Z" />
                                <TextBlock Grid.Column="1" Text="Embellecer…" Margin="10,0,0,0" />
                                <TextBlock x:Name="BeautifyState" Grid.Column="2" Text="Activado" Foreground="#FDD835" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <Popup x:Name="BeautifyPopup"
                   PlacementTarget="{Binding ElementName=MoreButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F2202124" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                    <StackPanel Width="288" RadioButton.Checked="OnBeautifyChoice">
                        <CheckBox x:Name="BeautifyEnabledBox" Content="Embellecer al copiar y guardar" Foreground="White"
                                  FontFamily="Segoe UI" FontSize="13" Focusable="False" Click="OnBeautifyEnabled" />

                        <Border Height="170" Margin="0,8,0,0" CornerRadius="6" Background="#26FFFFFF" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="BeautifyPreview" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                                <TextBlock x:Name="BeautifyEmpty" Text="Elige una zona para ver la vista previa" Foreground="#AAFFFFFF"
                                           FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Fondo" Style="{StaticResource PanelLabel}" />
                        <WrapPanel x:Name="BeautifyBackgrounds" />

                        <TextBlock Text="Margen" Style="{StaticResource PanelLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="beautyPadding" Tag="24" Style="{StaticResource Choice}">
                                <TextBlock Text="Pequeño" Margin="8,0" />
                            </RadioButton>
                            <RadioButton GroupName="beautyPadding" Tag="48" Style="{StaticResource Choice}">
                                <TextBlock Text="Medio" Margin="8,0" />
                            </RadioButton>
                            <RadioButton GroupName="beautyPadding" Tag="80" Style="{StaticResource Choice}">
                                <TextBlock Text="Grande" Margin="8,0" />
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Esquinas" Style="{StaticResource PanelLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="beautyRadius" Tag="0" Style="{StaticResource Choice}">
                                <TextBlock Text="Rectas" Margin="8,0" />
                            </RadioButton>
                            <RadioButton GroupName="beautyRadius" Tag="12" Style="{StaticResource Choice}">
                                <TextBlock Text="Suaves" Margin="8,0" />
                            </RadioButton>
                            <RadioButton GroupName="beautyRadius" Tag="24" Style="{StaticResource Choice}">
                                <TextBlock Text="Redondas" Margin="8,0" />
                            </RadioButton>
                        </StackPanel>

                        <CheckBox x:Name="BeautifyShadowBox" Content="Sombra" Foreground="White" Margin="0,10,0,0"
                                  FontFamily="Segoe UI" FontSize="13" Focusable="False" Click="OnBeautifyShadow" />
                    </StackPanel>
                </Border>
            </Popup>

            <Border Style="{StaticResource Divider}" />

            <!-- Each outcome has its own color, so they stand apart from the drawing tools. -->
            <Button Style="{StaticResource Action}" ToolTip="Cancelar y cerrar sin guardar (Esc)" AutomationProperties.Name="Cerrar" Click="OnClose">
                <Path Style="{StaticResource Icon}" Stroke="#EF5350" Data="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5" />
            </Button>
            <Button Style="{StaticResource Action}" ToolTip="Guardar como imagen (Ctrl+S)" AutomationProperties.Name="Guardar" Click="OnSave">
                <Path Style="{StaticResource Icon}" Stroke="#42A5F5"
                      Data="M2.5,2.5 H11 L13.5,5 V13.5 H2.5 Z M5,2.5 V6 H10.5 V2.5 M5,13.5 V9.5 H11 V13.5" />
            </Button>
            <Button x:Name="CopyActionButton" Style="{StaticResource Action}" ToolTip="Copiar al portapapeles (Enter)" AutomationProperties.Name="Copiar" Click="OnCopy">
                <Path Style="{StaticResource Icon}" Stroke="#66BB6A" Data="M5.5,5.5 H13.5 V13.5 H5.5 Z M3.5,10.5 H2.5 V2.5 H10.5 V3.5" />
            </Button>
        </StackPanel>
    </Border>
    </Canvas>
</UserControl>
