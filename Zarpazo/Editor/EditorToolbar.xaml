<UserControl x:Class="Zarpazo.Editor.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Arrow">
    <UserControl.Resources>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnChoicePressed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" MinWidth="32" Height="32" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" MinWidth="32" Height="32" Padding="8,0" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>

        <!-- Every icon is drawn on a 16 x 16 grid with the same stroke, so they read as one set. -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </UserControl.Resources>

    <Border Background="#F2202124" CornerRadius="10" Padding="5" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" RadioButton.Checked="OnChoice">
            <RadioButton x:Name="SelectTool" GroupName="tool" Tag="Select" IsChecked="True" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Ajustar zona"
                         ToolTip="Ajustar la zona: arrastra las asas o el interior. Arrastrar fuera elige otra zona y borra las anotaciones">
                <Path Style="{StaticResource Icon}" Data="M2.5,2.5 H13.5 V13.5 H2.5 Z" StrokeDashArray="2 1.6" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Move" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Mover anotaciones"
                         ToolTip="Mover anotaciones (Supr borra la seleccionada)">
                <Path Style="{StaticResource Icon}"
                      Data="M8,1.5 V14.5 M1.5,8 H14.5 M6,3.5 L8,1.5 L10,3.5 M6,12.5 L8,14.5 L10,12.5 M3.5,6 L1.5,8 L3.5,10 M12.5,6 L14.5,8 L12.5,10" />
            </RadioButton>

            <Border Style="{StaticResource Divider}" />

            <RadioButton GroupName="tool" Tag="Rectangle" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Rectángulo" ToolTip="Rectángulo">
                <Path Style="{StaticResource Icon}" Data="M2.5,3.5 H13.5 V12.5 H2.5 Z" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Ellipse" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Elipse" ToolTip="Elipse">
                <Path Style="{StaticResource Icon}" Data="M2,8 A6,5 0 1 0 14,8 A6,5 0 1 0 2,8 Z" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Line" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Línea" ToolTip="Línea">
                <Path Style="{StaticResource Icon}" Data="M3,13 L13,3" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Arrow" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Flecha" ToolTip="Flecha">
                <Path Style="{StaticResource Icon}" Data="M3,13 L13,3 M6.5,3 H13 V9.5" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Pen" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Lápiz" ToolTip="Lápiz">
                <Path Style="{StaticResource Icon}" Data="M2.5,13.5 L3.3,10 L10.8,2.5 L13.5,5.2 L6,12.7 Z M9.2,4.1 L11.9,6.8" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Highlighter" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Resaltador" ToolTip="Resaltador">
                <Grid Width="16" Height="16">
                    <Path Style="{StaticResource Icon}" Data="M10.5,1.8 L13.7,5 L7.2,11.5 L4,8.3 Z M4,8.3 L2.5,11.7 L6,10.5" />
                    <Path Style="{StaticResource Icon}" Data="M8,14.2 H14" Stroke="#FDD835" StrokeThickness="2" />
                </Grid>
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Text" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Texto" ToolTip="Texto (Enter confirma, Mayús+Enter salto de línea)">
                <Path Style="{StaticResource Icon}" Data="M3,4 V3 H13 V4 M8,3 V13 M6,13 H10" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Step" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Numeración de pasos" ToolTip="Numeración de pasos (un clic por número)">
                <Grid Width="16" Height="16">
                    <Ellipse Margin="0.75" Stroke="White" StrokeThickness="1.5" />
                    <TextBlock Text="1" Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Pixelate" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Pixelar" ToolTip="Pixelar para ocultar datos">
                <Grid Width="16" Height="16">
                    <Path Style="{StaticResource Icon}" StrokeThickness="0" Fill="#99FFFFFF"
                          Data="M2,2 H8 V8 H2 Z M8,8 H14 V14 H8 Z" />
                    <Path Style="{StaticResource Icon}" Data="M2.5,2.5 H13.5 V13.5 H2.5 Z M8,2.5 V13.5 M2.5,8 H13.5" />
                </Grid>
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Ruler" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Regla" ToolTip="Regla: mide una distancia en píxeles">
                <Path Style="{StaticResource Icon}" Data="M1.5,5.5 H14.5 V10.5 H1.5 Z M4.5,5.5 V8 M8,5.5 V8.5 M11.5,5.5 V8" />
            </RadioButton>
            <RadioButton GroupName="tool" Tag="Picker" Style="{StaticResource Choice}"
                         AutomationProperties.Name="Cuentagotas" ToolTip="Cuentagotas: clic copia el color, X cambia entre HEX y RGB">
                <Path Style="{StaticResource Icon}"
                      Data="M2.5,13.5 L3.2,10.3 L9.3,4.2 L11.8,6.7 L5.7,12.8 Z M8.5,5 L11,2.5 Q12.5,1 14,2.5 Q15.5,4 13.5,5.5 L11.5,7.5" />
            </RadioButton>

            <Border Style="{StaticResource Divider}" />

            <!-- Color and thickness are one button each showing the current choice; the options live in popups so they
                 don't take bar space. -->
            <Button x:Name="ColorButton" Style="{StaticResource Action}" ToolTip="Color" AutomationProperties.Name="Color" Click="OnColorButton">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ColorSwatch" Width="16" Height="16" Fill="#E53935" Stroke="#88FFFFFF" StrokeThickness="1" />
                    <TextBlock Text="▾" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Popup x:Name="ColorPopup"
                   PlacementTarget="{Binding ElementName=ColorButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F2202124" CornerRadius="8" Padding="4" Margin="0,0,0,6">
                    <StackPanel RadioButton.Checked="OnChoice">
                        <WrapPanel Width="204">
                            <RadioButton GroupName="color" Tag="#E53935" IsChecked="True" Style="{StaticResource Choice}" ToolTip="Rojo">
                                <Ellipse Width="16" Height="16" Fill="#E53935" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FB8C00" Style="{StaticResource Choice}" ToolTip="Naranja">
                                <Ellipse Width="16" Height="16" Fill="#FB8C00" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FDD835" Style="{StaticResource Choice}" ToolTip="Amarillo">
                                <Ellipse Width="16" Height="16" Fill="#FDD835" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#43A047" Style="{StaticResource Choice}" ToolTip="Verde">
                                <Ellipse Width="16" Height="16" Fill="#43A047" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#00ACC1" Style="{StaticResource Choice}" ToolTip="Turquesa">
                                <Ellipse Width="16" Height="16" Fill="#00ACC1" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#1E88E5" Style="{StaticResource Choice}" ToolTip="Azul">
                                <Ellipse Width="16" Height="16" Fill="#1E88E5" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#8E24AA" Style="{StaticResource Choice}" ToolTip="Morado">
                                <Ellipse Width="16" Height="16" Fill="#8E24AA" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#EC407A" Style="{StaticResource Choice}" ToolTip="Rosa">
                                <Ellipse Width="16" Height="16" Fill="#EC407A" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#6D4C41" Style="{StaticResource Choice}" ToolTip="Marrón">
                                <Ellipse Width="16" Height="16" Fill="#6D4C41" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#9E9E9E" Style="{StaticResource Choice}" ToolTip="Gris">
                                <Ellipse Width="16" Height="16" Fill="#9E9E9E" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#000000" Style="{StaticResource Choice}" ToolTip="Negro">
                                <Ellipse Width="16" Height="16" Fill="#000000" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <RadioButton GroupName="color" Tag="#FFFFFF" Style="{StaticResource Choice}" ToolTip="Blanco">
                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                            <!-- Appears after a custom color has been picked, so the choice shows up in the grid. -->
                            <RadioButton x:Name="CustomChoice" GroupName="color" Tag="#000000" Visibility="Collapsed"
                                         Style="{StaticResource Choice}" ToolTip="Color personalizado">
                                <Ellipse x:Name="CustomDot" Width="16" Height="16" Fill="Black" Stroke="#88FFFFFF" StrokeThickness="1" />
                            </RadioButton>
                        </WrapPanel>
                        <Button Style="{StaticResource Action}" Content="Personalizado…" Margin="1,4,1,0" Click="OnCustomColor" />
                    </StackPanel>
                </Border>
            </Popup>

            <Button x:Name="SizeButton" Style="{StaticResource Action}" ToolTip="Grosor (y tamaño del texto)"
                    AutomationProperties.Name="Grosor" Click="OnSizeButton">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16">
                        <Ellipse x:Name="SizeSwatch" Width="8" Height="8" Fill="White" />
                    </Grid>
                    <TextBlock Text="▾" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Popup x:Name="SizePopup"
                   PlacementTarget="{Binding ElementName=SizeButton}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#F2202124" CornerRadius="8" Padding="4" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" RadioButton.Checked="OnChoice">
                        <RadioButton GroupName="size" Tag="2" Style="{StaticResource Choice}" ToolTip="Fino">
                            <Ellipse Width="4" Height="4" Fill="White" />
                        </RadioButton>
                        <RadioButton GroupName="size" Tag="4" IsChecked="True" Style="{StaticResource Choice}" ToolTip="Medio">
                            <Ellipse Width="8" Height="8" Fill="White" />
                        </RadioButton>
                        <RadioButton GroupName="size" Tag="8" Style="{StaticResource Choice}" ToolTip="Grueso">
                            <Ellipse Width="13" Height="13" Fill="White" />
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Popup>

            <Border Style="{StaticResource Divider}" />

            <Button Style="{StaticResource Action}" ToolTip="Deshacer (Ctrl+Z)" AutomationProperties.Name="Deshacer" Click="OnUndo">
                <Path Style="{StaticResource Icon}" Data="M5,3 L2,6 L5,9 M2,6 H9.5 A3.5,3.5 0 0 1 9.5,13 H6" />
            </Button>
            <Button Style="{StaticResource Action}" ToolTip="Rehacer (Ctrl+Y)" AutomationProperties.Name="Rehacer" Click="OnRedo">
                <Path Style="{StaticResource Icon}" Data="M11,3 L14,6 L11,9 M14,6 H6.5 A3.5,3.5 0 0 0 6.5,13 H10" />
            </Button>

            <Border Style="{StaticResource Divider}" />

            <Button Style="{StaticResource Action}" ToolTip="Copiar el texto de la imagen (Ctrl+T)" AutomationProperties.Name="Copiar texto" Click="OnOcr">
                <Path Style="{StaticResource Icon}" Data="M1.5,5 V1.5 H5 M11,1.5 H14.5 V5 M14.5,11 V14.5 H11 M5,14.5 H1.5 V11 M5,5.5 H11 M8,5.5 V11" />
            </Button>

            <Border Style="{StaticResource Divider}" />

            <!-- Each outcome has its own color, so they stand apart from the drawing tools. -->
            <Button Style="{StaticResource Action}" ToolTip="Cerrar sin guardar (Esc)" AutomationProperties.Name="Cerrar" Click="OnClose">
                <Path Style="{StaticResource Icon}" Stroke="#EF5350" Data="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5" />
            </Button>
            <Button Style="{StaticResource Action}" ToolTip="Guardar como imagen (Ctrl+S)" AutomationProperties.Name="Guardar" Click="OnSave">
                <Path Style="{StaticResource Icon}" Stroke="#42A5F5"
                      Data="M2.5,2.5 H11 L13.5,5 V13.5 H2.5 Z M5,2.5 V6 H10.5 V2.5 M5,13.5 V9.5 H11 V13.5" />
            </Button>
            <Button Style="{StaticResource Action}" ToolTip="Copiar al portapapeles (Enter)" AutomationProperties.Name="Copiar" Click="OnCopy">
                <Path Style="{StaticResource Icon}" Stroke="#66BB6A" Data="M5.5,5.5 H13.5 V13.5 H5.5 Z M3.5,10.5 H2.5 V2.5 H10.5 V3.5" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
