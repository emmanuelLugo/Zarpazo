<Window x:Class="Zarpazo.Recording.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recortar video"
        Width="660"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13">
    <StackPanel Margin="14">
        <Border Background="Black" Height="340" CornerRadius="4">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                          Stretch="Uniform" IsMuted="False" MediaOpened="OnOpened" MediaFailed="OnFailed" />
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Width="92" Padding="0,4" Content="▶ Reproducir" Click="OnPlay" IsEnabled="False" />
            <ProgressBar x:Name="PositionBar" Grid.Column="1" Height="6" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="PositionText" Grid.Column="2" FontFamily="Consolas" VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="8" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Inicio" VerticalAlignment="Center" />
            <Slider x:Name="StartSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="OnStartChanged"
                    ToolTip="Hasta dónde se quita del principio" />
            <TextBlock x:Name="StartText" Grid.Column="2" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Text="Fin" Grid.Row="2" VerticalAlignment="Center" />
            <Slider x:Name="EndSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="1" IsEnabled="False" ValueChanged="OnEndChanged"
                    ToolTip="Desde dónde se quita del final" />
            <TextBlock x:Name="EndText" Grid.Row="2" Grid.Column="2" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="KeptText" Foreground="#FF666666" Margin="0,10,0,0" />
        <ProgressBar x:Name="WorkBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Guardar recorte" Padding="14,4" Margin="0,0,8,0" IsDefault="True" IsEnabled="False" Click="OnSave" />
            <Button x:Name="CancelButton" Content="Cancelar" Padding="14,4" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
