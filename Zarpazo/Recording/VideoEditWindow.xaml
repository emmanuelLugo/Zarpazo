<Window x:Class="Zarpazo.Recording.VideoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zarpazo.Recording"
        Title="Editar video"
        Width="1320"
        Height="880"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnKeyDown"
        Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A background to choose for the frame: a rounded swatch of it, ringed when chosen. -->
            <Style x:Key="Swatch" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                <Border CornerRadius="6" Background="{TemplateBinding Background}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A choice of the pointer's shape: a tile with a drawing of it, ringed when chosen. -->
            <Style x:Key="Tile" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SliderValue" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>
            <!-- icons: drawn on a 24 x 24 grid, shown at 18 px, in the colour of the button they are on -->
            <Style x:Key="Glyph" TargetType="Path">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FilledGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>
            <Geometry x:Key="UndoGlyph">M9,14 L4,9 L9,4 M4,9 H15 A5,5 0 0 1 15,19 H11</Geometry>
            <Geometry x:Key="RedoGlyph">M15,14 L20,9 L15,4 M20,9 H9 A5,5 0 0 0 9,19 H13</Geometry>
            <Geometry x:Key="ResetGlyph">M3.5,12 A8.5,8.5 0 1 0 6,6 M3.5,3.5 V8.5 H8.5</Geometry>
            <Geometry x:Key="FrameGlyph">M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M8,8 H16 V16 H8 Z</Geometry>
            <Geometry x:Key="PointerGlyphIcon">M5,3 L11,20 L13.5,13.5 L20,11 Z</Geometry>
            <Geometry x:Key="PresetGlyph">M12,3 L14.5,8.5 L20.5,9.2 L16,13.2 L17.3,19.2 L12,16.2 L6.7,19.2 L8,13.2 L3.5,9.2 L9.5,8.5 Z</Geometry>
            <Geometry x:Key="CheckGlyph">M5,12.5 L10,17.5 L19,7</Geometry>
            <Geometry x:Key="RenameGlyph">M4,20 H8 L19,9 A2.1,2.1 0 0 0 16,6 L5,17 Z M14,8 L17,11</Geometry>
            <Geometry x:Key="CropGlyph">M6,2 V18 H22 M2,6 H18 V22</Geometry>
            <Geometry x:Key="ZoomGlyph">M10.5,3.5 A7,7 0 1 0 10.5,17.5 A7,7 0 1 0 10.5,3.5 Z M20.5,20.5 L15.5,15.5 M10.5,7.5 V13.5 M7.5,10.5 H13.5</Geometry>
            <Geometry x:Key="SplitGlyph">M6,3 A3,3 0 1 0 6,9 A3,3 0 1 0 6,3 Z M6,15 A3,3 0 1 0 6,21 A3,3 0 1 0 6,15 Z M20,4 L8.1,15.9 M14.5,14.5 L20,20 M8.1,8.1 L12,12</Geometry>
            <Geometry x:Key="TrashGlyph">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7</Geometry>
            <Geometry x:Key="DuplicateGlyph">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M4,16 V6 A2,2 0 0 1 6,4 H16</Geometry>
            <Geometry x:Key="SoundGlyph">M11,5 L6,9 H3 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5 M18.5,5.5 A9,9 0 0 1 18.5,18.5</Geometry>
            <Geometry x:Key="MutedGlyph">M11,5 L6,9 H3 V15 H6 L11,19 Z M22,9 L16,15 M16,9 L22,15</Geometry>
            <Geometry x:Key="MoveLeftGlyph">M19,12 H6 M11,17 L6,12 L11,7 M3,5 V19</Geometry>
            <Geometry x:Key="MoveRightGlyph">M5,12 H18 M13,17 L18,12 L13,7 M21,5 V19</Geometry>
            <Geometry x:Key="StepBackGlyph">M17,18 L11,12 L17,6 M7,6 V18</Geometry>
            <Geometry x:Key="StepForwardGlyph">M7,18 L13,12 L7,6 M17,6 V18</Geometry>
            <Geometry x:Key="PlayGlyph">M8,5.5 A1,1 0 0 1 9.5,4.6 L19,11.1 A1,1 0 0 1 19,12.9 L9.5,19.4 A1,1 0 0 1 8,18.5 Z</Geometry>
            <Geometry x:Key="PauseGlyph">M7,4.5 H10 A1,1 0 0 1 11,5.5 V18.5 A1,1 0 0 1 10,19.5 H7 A1,1 0 0 1 6,18.5 V5.5 A1,1 0 0 1 7,4.5 Z M14,4.5 H17 A1,1 0 0 1 18,5.5 V18.5 A1,1 0 0 1 17,19.5 H14 A1,1 0 0 1 13,18.5 V5.5 A1,1 0 0 1 14,4.5 Z</Geometry>
            <Geometry x:Key="CopyGlyph">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M4,16 V6 A2,2 0 0 1 6,4 H16</Geometry>
            <Geometry x:Key="SaveGlyph">M12,3 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
            <Geometry x:Key="FolderGlyph">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z</Geometry>
            <Geometry x:Key="SparkleGlyph">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 Z</Geometry>
            <Geometry x:Key="PlusGlyph">M12,5 V19 M5,12 H19</Geometry>
            <Geometry x:Key="TimelineZoomGlyph">M10.5,3.5 A7,7 0 1 0 10.5,17.5 A7,7 0 1 0 10.5,3.5 Z M20.5,20.5 L15.5,15.5</Geometry>

            <!-- A square button with only an icon: quiet until the pointer is on it. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Width="34" Height="34" CornerRadius="8" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The big round play button in the middle of the controls. -->
            <Style x:Key="PlayButtonStyle" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackground}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource TextPrimary}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The icons down the left that choose the panel: the chosen one lit up in the accent colour. -->
            <Style x:Key="RailButton" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" Width="40" Height="40" CornerRadius="10" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The title of a side panel, small and in capitals, like a section of settings. -->
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <!-- A setting as a row, like Recordly's: the whole row is the slider, filled up to its value, with a thin knob;
                 its name and value are written over it by the panel. A click anywhere on it moves the value there. -->
            <Style x:Key="RowFill" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{DynamicResource Pressed}" CornerRadius="8,0,0,8" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RowRest" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RowKnob" TargetType="Thumb">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="10" Background="Transparent">
                                <Border Width="2" Height="18" CornerRadius="1" Background="{DynamicResource TextPrimary}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RowSlider" TargetType="Slider">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="local:SliderDrag.Anywhere" Value="True" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Border Height="38" CornerRadius="8" Background="{DynamicResource Surface}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource RowFill}" Command="Slider.DecreaseLarge" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource RowRest}" Command="Slider.IncreaseLarge" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource RowKnob}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="14,0" />
            </Style>
            <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- An on/off setting as a switch, with its name on the left. -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource BorderStrong}">
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- "Restablecer" next to a section's title: a link in the accent colour. -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SubHeader" TargetType="TextBlock" BasedOn="{StaticResource PanelHeader}">
                <Setter Property="Margin" Value="0,18,0,10" />
            </Style>
            <!-- A choice written in words (Suave, Enfocado), ringed when chosen like the other tiles. -->
            <Style x:Key="WordTile" TargetType="RadioButton" BasedOn="{StaticResource Tile}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Style>
            <!-- A preset in the list: its name, flat until the pointer is on it; a click applies it. -->
            <Style x:Key="PresetRow" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" CornerRadius="8" Background="Transparent" Padding="6,7">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar: undo and redo, the video's name and how it went, and handing the video out -->
        <Grid Height="56" Background="{DynamicResource InputBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="OnUndo" IsEnabled="False" ToolTip="Deshacer (Ctrl+Z)">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource UndoGlyph}" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="OnRedo" IsEnabled="False" ToolTip="Rehacer (Ctrl+Y)">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource RedoGlyph}" />
                </Button>
                <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Click="OnReset" IsEnabled="False" Margin="4,0,0,0"
                        ToolTip="Restablecer: vuelve al video completo, tal como se grabó">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ResetGlyph}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock x:Name="DeliveryText" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ShowInFolderButton" Style="{StaticResource IconButton}" Visibility="Collapsed" Click="OnShowInFolder"
                            Margin="4,-8,0,-8" ToolTip="Mostrar en la carpeta">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource FolderGlyph}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="PresetsButton" Margin="0,0,8,0" Padding="12,6" Focusable="False" Click="OnPresets"
                        ToolTip="Guarda el marco, el cursor y el estilo del zoom con un nombre, y aplícalos a otro video con un clic">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource PresetGlyph}" Margin="0,0,6,0" />
                        <TextBlock Text="Presets" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="PresetsPopup" PlacementTarget="{Binding ElementName=PresetsButton}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" Closed="OnPresetsClosed">
                    <Border Width="320" Margin="0,6,0,0" CornerRadius="12" Padding="14,14,14,12" Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource PanelHeader}" />
                            <TextBlock x:Name="PresetsEmptyText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       Text="Todavía no hay presets. Elige un marco, un cursor y un estilo de zoom, y guárdalos aquí con un nombre." />
                            <StackPanel x:Name="PresetRows" />
                            <TextBlock Text="GUARDAR EL ESTILO ACTUAL" Style="{StaticResource SubHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PresetNameBox" MaxLength="40" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="OnPresetNameKeyDown"
                                         ToolTip="Un nombre para el marco, el cursor y el estilo del zoom de ahora. Si ya existe, se actualiza" />
                                <Button Grid.Column="1" Content="Guardar" Padding="12,5" Focusable="False" Click="OnSavePreset" />
                            </Grid>
                            <TextBlock x:Name="PresetNote" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.8"
                                       Text="Un preset no guarda el recorte, los cortes ni los zooms de este video." />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="CopyButton" Margin="0,0,8,0" Padding="12,6" Focusable="False" IsEnabled="False" Click="OnCopy"
                        ToolTip="Copia el video terminado para pegarlo en un chat o un documento">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource CopyGlyph}" Margin="0,0,6,0" />
                        <TextBlock Text="Copiar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Padding="14,6" Focusable="False" IsDefault="True" IsEnabled="False" Click="OnSave"
                        ToolTip="Guarda el video terminado como archivo; la grabación original no se toca">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource SaveGlyph}" Margin="0,0,6,0" />
                        <TextBlock Text="Guardar…" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- While the finished video is being made: a thin line along the bottom of the bar. -->
            <ProgressBar x:Name="WorkBar" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
        </Grid>

        <!-- the icons, the chosen panel, and the video -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="10,14,0,0">
                <RadioButton x:Name="FrameTab" Style="{StaticResource RailButton}" GroupName="sidePanel" IsChecked="True" Checked="OnPanelTab" ToolTip="Marco y fondo">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource FrameGlyph}" />
                </RadioButton>
                <RadioButton x:Name="CursorTab" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Cursor">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource PointerGlyphIcon}" />
                </RadioButton>
                <RadioButton x:Name="ZoomTab" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Zoom">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ZoomGlyph}" />
                </RadioButton>
                <RadioButton x:Name="CropTab" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Recorte">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource CropGlyph}" />
                </RadioButton>
            </StackPanel>

            <Border Grid.Column="1" Margin="4,14,0,12" CornerRadius="12" Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="16,14"
                              PreviewMouseLeftButtonDown="OnPanelRowsDown" PreviewMouseLeftButtonUp="OnPanelRowsUp" LostMouseCapture="OnPanelRowsUp">
                    <Grid>
                        <!-- The frame: a background behind the recording, room around it, rounded corners and a shadow. -->
                        <StackPanel x:Name="FramePanel">
                            <Grid>
                                <TextBlock Text="MARCO" Style="{StaticResource PanelHeader}" />
                                <Button x:Name="FrameResetButton" Content="Restablecer" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="OnFrameReset" ToolTip="Vuelve a los valores de fábrica del marco" />
                            </Grid>
                            <CheckBox x:Name="FrameBox" Content="Poner marco" Style="{StaticResource Switch}" Click="OnFrameChanged"
                                      ToolTip="Pone el video sobre un fondo, con margen, esquinas redondeadas y sombra. Con zoom, el video crece y el fondo sale de la imagen" />
                            <StackPanel x:Name="FrameOptions">
                                <TextBlock Text="FONDO" Style="{StaticResource SubHeader}" />
                                <WrapPanel x:Name="FrameBackgrounds" />
                                <TextBlock Text="FORMA" Style="{StaticResource SubHeader}" />
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="FramePaddingSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="0.15" SmallChange="0.005" LargeChange="0.02"
                                            ValueChanged="OnFrameSlider" ToolTip="El espacio de fondo alrededor del video" />
                                    <TextBlock Text="Relleno" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="FramePaddingText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="FrameRadiusSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="0.05" SmallChange="0.002" LargeChange="0.01"
                                            ValueChanged="OnFrameSlider" ToolTip="Cuán redondeadas son las esquinas del video" />
                                    <TextBlock Text="Radio" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="FrameRadiusText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="FrameShadowSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                                            ValueChanged="OnFrameSlider" ToolTip="Cuán oscura es la sombra bajo el video" />
                                    <TextBlock Text="Sombra" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="FrameShadowText" Style="{StaticResource RowValue}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- The pointer: the video is recorded without it, and the one drawn here goes into the saved video. -->
                        <StackPanel x:Name="CursorPanel" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="CURSOR" Style="{StaticResource PanelHeader}" />
                                <Button x:Name="CursorResetButton" Content="Restablecer" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="OnCursorReset" ToolTip="Vuelve a los valores de fábrica del cursor" />
                            </Grid>
                            <CheckBox x:Name="CursorBox" Content="Mostrar cursor" Style="{StaticResource Switch}" Click="OnCursorChanged"
                                      ToolTip="Dibuja el puntero en el video: más grande, con movimiento suave y un efecto en cada clic" />
                            <TextBlock x:Name="CursorNote" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Visibility="Collapsed" />
                            <StackPanel x:Name="CursorOptions">
                                <TextBlock Text="ESTILO" Style="{StaticResource SubHeader}" />
                                <StackPanel x:Name="CursorShapes" Orientation="Horizontal" />
                                <TextBlock Text="MOVIMIENTO" Style="{StaticResource SubHeader}" />
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CursorSizeSlider" Style="{StaticResource RowSlider}" Minimum="1" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                            ValueChanged="OnCursorSlider" ToolTip="Cuántas veces más grande que el puntero en la pantalla" />
                                    <TextBlock Text="Tamaño" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CursorSizeText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CursorSmoothingSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25"
                                            ValueChanged="OnCursorSlider" ToolTip="Quita el temblor de la mano: el puntero se desliza en lugar de saltar" />
                                    <TextBlock Text="Suavizado" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CursorSmoothingText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CursorSwaySlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25"
                                            ValueChanged="OnCursorSlider" ToolTip="Cuánto se inclina la flecha al moverse de lado" />
                                    <TextBlock Text="Balanceo" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CursorSwayText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <TextBlock Text="EFECTO DE CLIC" Style="{StaticResource SubHeader}" />
                                <StackPanel x:Name="CursorClicks" Orientation="Horizontal" />
                                <CheckBox x:Name="CursorBounceBox" Content="Rebote al hacer clic" Style="{StaticResource Switch}" Margin="0,10,0,0" Click="OnCursorChanged"
                                          ToolTip="El puntero se encoge un instante en cada clic, como si se presionara" />
                            </StackPanel>
                        </StackPanel>

                        <!-- The crop: what is cut from each side of the picture (the taskbar, a browser's tabs). It belongs to this
                             video, so it is undone with the edit and not remembered for the next one. -->
                        <StackPanel x:Name="CropPanel" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="RECORTE" Style="{StaticResource PanelHeader}" />
                                <Button x:Name="CropResetButton" Content="Restablecer" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="OnCropReset" ToolTip="Vuelve a la imagen completa (se puede deshacer)" />
                            </Grid>
                            <StackPanel x:Name="CropOptions">
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CropTopSlider" Tag="{x:Static local:CropEdges.Top}" Style="{StaticResource RowSlider}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" ToolTip="Cuánto se quita de arriba, por ejemplo las pestañas del navegador" />
                                    <TextBlock Text="Superior" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CropTopText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CropBottomSlider" Tag="{x:Static local:CropEdges.Bottom}" Style="{StaticResource RowSlider}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" ToolTip="Cuánto se quita de abajo, por ejemplo la barra de tareas" />
                                    <TextBlock Text="Inferior" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CropBottomText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CropLeftSlider" Tag="{x:Static local:CropEdges.Left}" Style="{StaticResource RowSlider}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" ToolTip="Cuánto se quita de la izquierda" />
                                    <TextBlock Text="Izquierda" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CropLeftText" Style="{StaticResource RowValue}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Slider x:Name="CropRightSlider" Tag="{x:Static local:CropEdges.Right}" Style="{StaticResource RowSlider}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" ToolTip="Cuánto se quita de la derecha" />
                                    <TextBlock Text="Derecha" Style="{StaticResource RowLabel}" />
                                    <TextBlock x:Name="CropRightText" Style="{StaticResource RowValue}" />
                                </Grid>
                            </StackPanel>
                            <TextBlock x:Name="CropSizeText" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="También puedes arrastrar los bordes, las esquinas o el centro del rectángulo sobre el video. Al reproducir o cambiar de panel se ve el resultado." />
                        </StackPanel>

                        <!-- The zooms: suggested from the clicks or added by hand; the chosen one can be changed here. -->
                        <StackPanel x:Name="ZoomPanel" Visibility="Collapsed">
                            <TextBlock Text="ZOOM" Style="{StaticResource PanelHeader}" />
                            <Button x:Name="AutoZoomButton" Focusable="False" IsEnabled="False" Click="OnAutoZoom" HorizontalContentAlignment="Left" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource SparkleGlyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="Zoom automático" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddZoomButton" Focusable="False" IsEnabled="False" Click="OnAddZoom" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,8,0,0"
                                    ToolTip="Añade un zoom donde está la línea roja (Z). También con doble clic en la fila de zooms">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource PlusGlyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="Añadir zoom aquí" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Los zooms están en la fila de abajo de la línea de tiempo: arrástralos para moverlos o estira sus bordes para alargarlos." />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="ESTILO" Style="{StaticResource SubHeader}" />
                                <Button x:Name="ZoomStyleResetButton" Content="Restablecer" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,8,0,0" Click="OnZoomStyleReset" ToolTip="Vuelve a 1,5× y movimiento suave" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Slider x:Name="ZoomStyleDepthSlider" Style="{StaticResource RowSlider}" Minimum="1.1" Maximum="3" SmallChange="0.05" LargeChange="0.25"
                                        ValueChanged="OnZoomStyleSlider" ToolTip="Cuánto acercan los zooms de este video y los que se añadan" />
                                <TextBlock Text="Acercar" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="ZoomStyleDepthText" Style="{StaticResource RowValue}" />
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <RadioButton x:Name="ZoomSmoothTile" Style="{StaticResource WordTile}" GroupName="zoomMotion" Content="Suave" Click="OnZoomStyleChanged"
                                             ToolTip="Entra y sale despacio (1,5 s): para presentaciones" />
                                <RadioButton x:Name="ZoomFocusedTile" Style="{StaticResource WordTile}" GroupName="zoomMotion" Content="Enfocado" Click="OnZoomStyleChanged"
                                             Margin="0" ToolTip="Entra y sale rápido (0,8 s): para tutoriales de clic en clic" />
                            </UniformGrid>
                            <StackPanel x:Name="ZoomDetails" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="Zoom elegido" Style="{StaticResource PanelTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Acercar" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox x:Name="ZoomDepthBox" Grid.Column="1" Focusable="False" SelectionChanged="OnZoomDepthChanged" ToolTip="Cuánto se acerca este zoom">
                                        <ComboBoxItem Content="1,25×" Tag="1.25" />
                                        <ComboBoxItem Content="1,5×" Tag="1.5" />
                                        <ComboBoxItem Content="1,8×" Tag="1.8" />
                                        <ComboBoxItem Content="2×" Tag="2" />
                                        <ComboBoxItem Content="2,5×" Tag="2.5" />
                                        <ComboBoxItem Content="3×" Tag="3" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Haz clic o arrastra en el video para elegir adónde mira." Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Button x:Name="DeleteZoomButton" Focusable="False" Click="OnDeleteZoom" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,10,0,0"
                                        ToolTip="Quita el zoom elegido (Supr)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource TrashGlyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="Quitar zoom" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2" Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The scene is drawn at the video's own size inside the Viewbox, so the zoom and the frame are worked out in its pixels.
                     The camera (the zoom) moves the Scene; the frame is its backdrop and the place of the recording in it. -->
                <Border Background="Black" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox x:Name="StageBox" Stretch="Uniform" SizeChanged="OnStageBoxSizeChanged">
                        <Grid x:Name="Stage" ClipToBounds="True" Background="Black"
                              MouseLeftButtonDown="OnStageMouseDown" MouseMove="OnStageMouseMove" MouseLeftButtonUp="OnStageMouseUp">
                            <Grid x:Name="Scene">
                                <!-- The frame's backdrop, live (a gradient and a card with the shadow): a slider changes only what the graphics
                                     card draws, so it follows the hand. The saved video draws the same with FrameBackdrop. -->
                                <Grid x:Name="Backdrop" Visibility="Collapsed">
                                    <Border x:Name="BackdropFill" />
                                    <Border x:Name="ShadowCard" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black" />
                                </Grid>
                                <!-- The recording at its own size; a crop shifts it so the part kept starts at the corner, and the
                                     host's clip hides the rest: all of it done by the graphics card. -->
                                <Grid x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Canvas>
                                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                                      Stretch="Fill" IsMuted="False" MediaOpened="OnOpened" MediaFailed="OnFailed" MediaEnded="OnMediaEnded" />
                                    </Canvas>
                                </Grid>
                            </Grid>
                            <!-- The pointer the saved video will have, drawn over the scene where the camera shows it (not zoomed with
                                 the picture, so it stays sharp), with the effects of the clicks under it. -->
                            <Canvas x:Name="PointerLayer" IsHitTestVisible="False" Visibility="Collapsed">
                                <Canvas x:Name="ClickMarks" />
                                <Canvas x:Name="PointerGlyph">
                                    <Canvas.Effect>
                                        <DropShadowEffect ShadowDepth="1.6" Direction="270" BlurRadius="4" Opacity="0.4" />
                                    </Canvas.Effect>
                                    <Path x:Name="PointerEdge" StrokeLineJoin="Round" />
                                    <Path x:Name="PointerFill" />
                                </Canvas>
                            </Canvas>
                            <!-- While the crop panel is open: the whole recording, dimmed outside what is kept, with a rectangle
                                 whose sides, corners and middle can be dragged. -->
                            <Canvas x:Name="CropLayer" Visibility="Collapsed" IsHitTestVisible="False">
                                <Path x:Name="CropShade" Fill="#A6000000" />
                                <Rectangle x:Name="CropFrame" Stroke="White" />
                                <Canvas x:Name="CropHandles" />
                            </Canvas>
                            <!-- While a zoom is chosen: the whole picture, dimmed outside what the zoom will show. -->
                            <Canvas x:Name="FocusLayer" Visibility="Collapsed" IsHitTestVisible="False">
                                <Path x:Name="FocusShade" Fill="#99000000" />
                                <Rectangle x:Name="FocusFrame" Stroke="#8E6CEF" />
                                <Ellipse x:Name="FocusDot" Fill="#8E6CEF" Stroke="White" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- The controls under the video: tools for the chosen piece on the left, playing in the middle, the timeline's zoom on the right. -->
                <Grid Grid.Row="1" Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SplitButton" Style="{StaticResource IconButton}" Click="OnSplit" IsEnabled="False"
                                ToolTip="Dividir: corta la parte donde está la línea roja (S)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource SplitGlyph}" />
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="OnDelete" IsEnabled="False"
                                ToolTip="Eliminar la parte seleccionada; las siguientes se juntan (Supr)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource TrashGlyph}" />
                        </Button>
                        <Button x:Name="DuplicateButton" Style="{StaticResource IconButton}" Click="OnDuplicate" IsEnabled="False"
                                ToolTip="Duplicar la parte seleccionada justo después (Ctrl+D)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource DuplicateGlyph}" />
                        </Button>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Click="OnMute" IsEnabled="False"
                                ToolTip="Silenciar la parte seleccionada (M)">
                            <Path x:Name="MuteIcon" Style="{StaticResource Glyph}" Data="{StaticResource SoundGlyph}" />
                        </Button>
                        <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" Click="OnSpeedButton" IsEnabled="False"
                                ToolTip="Velocidad de la parte seleccionada: más rápida para lo que es largo, más lenta para lo que pasa rápido">
                            <TextBlock x:Name="SpeedText" Text="1×" FontSize="11" FontWeight="SemiBold" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SpeedMenu" Placement="Top" Opened="OnSpeedMenuOpened" />
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="MoveLeftButton" Style="{StaticResource IconButton}" Click="OnMoveLeft" IsEnabled="False"
                                ToolTip="Pasar la parte seleccionada antes de la anterior (Alt+←). También se arrastra por su título">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource MoveLeftGlyph}" />
                        </Button>
                        <Button x:Name="MoveRightButton" Style="{StaticResource IconButton}" Click="OnMoveRight" IsEnabled="False"
                                ToolTip="Pasar la parte seleccionada después de la siguiente (Alt+→)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource MoveRightGlyph}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PositionText" Width="132" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondary}" />
                        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="OnStepBack" IsEnabled="False"
                                ToolTip="Un cuadro atrás (←). Con Mayús, un segundo">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource StepBackGlyph}" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Margin="6,0" Click="OnPlay" IsEnabled="False"
                                ToolTip="Reproducir lo que quedará (Espacio)">
                            <Path x:Name="PlayIcon" Style="{StaticResource FilledGlyph}" Data="{StaticResource PlayGlyph}" />
                        </Button>
                        <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="OnStepForward" IsEnabled="False"
                                ToolTip="Un cuadro adelante (→). Con Mayús, un segundo">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource StepForwardGlyph}" />
                        </Button>
                        <Border Width="142" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource TimelineZoomGlyph}" Stroke="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                        <Slider x:Name="ZoomSlider" Width="130" Minimum="1" Maximum="24" Value="1" IsEnabled="False" ValueChanged="OnZoomChanged"
                                VerticalAlignment="Center" Focusable="False" ToolTip="Acerca la línea de tiempo (Ctrl + rueda del ratón)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- the timeline, the whole width, and a line about the edit -->
        <StackPanel Grid.Row="2" Margin="16,0,16,12">
            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="0,0,0,2">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnTimelineWheel" SizeChanged="OnScrollerSizeChanged">
                    <StackPanel>
                    <local:TimelineView x:Name="View" SelectionChanged="OnSelectionChanged" Scrubbed="OnTimelineScrubbed" Previewed="OnPreviewed"
                                        GestureFinished="OnGestureFinished" ZoomRequested="OnZoomRequested">
                        <local:TimelineView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Dividir aquí" InputGestureText="S" Click="OnSplit" />
                                <MenuItem Header="Duplicar" InputGestureText="Ctrl+D" Click="OnDuplicate" />
                                <MenuItem x:Name="MuteMenuItem" Header="Silenciar" InputGestureText="M" Click="OnMute" />
                                <MenuItem x:Name="SpeedMenuItem" Header="Velocidad" />
                                <Separator />
                                <MenuItem Header="Eliminar" InputGestureText="Supr" Click="OnDelete" />
                            </ContextMenu>
                        </local:TimelineView.ContextMenu>
                    </local:TimelineView>
                    <local:ZoomLaneView x:Name="Lane" Margin="0,0,0,4" SelectionChanged="OnZoomSelectionChanged" Scrubbed="OnScrubbed"
                                        AddRequested="OnZoomAddRequested" GestureFinished="OnGestureFinished" ZoomRequested="OnZoomRequested">
                        <local:ZoomLaneView.ContextMenu>
                            <ContextMenu x:Name="ZoomMenu">
                                <MenuItem Header="Quitar zoom" InputGestureText="Supr" Click="OnDeleteZoom" />
                            </ContextMenu>
                        </local:ZoomLaneView.ContextMenu>
                    </local:ZoomLaneView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Margin="2,8,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="KeptText" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectionText" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
