<Window x:Class="Zarpazo.Recording.VideoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zarpazo.Recording"
        Title="Editar video"
        Width="1320"
        Height="880"
        MinWidth="1040"
        MinHeight="700"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnKeyDown"
        Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A choice of the pointer's shape: a tile with a drawing of it, ringed when chosen. -->
            <Style x:Key="Tile" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SliderValue" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>
            <!-- icons: drawn on a 24 x 24 grid, shown at 18 px, in the colour of the button they are on -->
            <Style x:Key="Glyph" TargetType="Path">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FilledGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>
            <Geometry x:Key="UndoGlyph">M9,14 L4,9 L9,4 M4,9 H15 A5,5 0 0 1 15,19 H11</Geometry>
            <Geometry x:Key="RedoGlyph">M15,14 L20,9 L15,4 M20,9 H9 A5,5 0 0 0 9,19 H13</Geometry>
            <Geometry x:Key="ResetGlyph">M3.5,12 A8.5,8.5 0 1 0 6,6 M3.5,3.5 V8.5 H8.5</Geometry>
            <Geometry x:Key="FrameGlyph">M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M8,8 H16 V16 H8 Z</Geometry>
            <Geometry x:Key="PointerGlyphIcon">M5,3 L11,20 L13.5,13.5 L20,11 Z</Geometry>
            <Geometry x:Key="PresetGlyph">M12,3 L14.5,8.5 L20.5,9.2 L16,13.2 L17.3,19.2 L12,16.2 L6.7,19.2 L8,13.2 L3.5,9.2 L9.5,8.5 Z</Geometry>
            <Geometry x:Key="CheckGlyph">M5,12.5 L10,17.5 L19,7</Geometry>
            <Geometry x:Key="RenameGlyph">M4,20 H8 L19,9 A2.1,2.1 0 0 0 16,6 L5,17 Z M14,8 L17,11</Geometry>
            <Geometry x:Key="CropGlyph">M6,2 V18 H22 M2,6 H18 V22</Geometry>
            <Geometry x:Key="ZoomGlyph">M10.5,3.5 A7,7 0 1 0 10.5,17.5 A7,7 0 1 0 10.5,3.5 Z M20.5,20.5 L15.5,15.5 M10.5,7.5 V13.5 M7.5,10.5 H13.5</Geometry>
            <Geometry x:Key="SplitGlyph">M6,3 A3,3 0 1 0 6,9 A3,3 0 1 0 6,3 Z M6,15 A3,3 0 1 0 6,21 A3,3 0 1 0 6,15 Z M20,4 L8.1,15.9 M14.5,14.5 L20,20 M8.1,8.1 L12,12</Geometry>
            <Geometry x:Key="TrashGlyph">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7</Geometry>
            <Geometry x:Key="DuplicateGlyph">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M4,16 V6 A2,2 0 0 1 6,4 H16</Geometry>
            <Geometry x:Key="SoundGlyph">M11,5 L6,9 H3 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5 M18.5,5.5 A9,9 0 0 1 18.5,18.5</Geometry>
            <Geometry x:Key="MutedGlyph">M11,5 L6,9 H3 V15 H6 L11,19 Z M22,9 L16,15 M16,9 L22,15</Geometry>
            <Geometry x:Key="MoveLeftGlyph">M19,12 H6 M11,17 L6,12 L11,7 M3,5 V19</Geometry>
            <Geometry x:Key="MoveRightGlyph">M5,12 H18 M13,17 L18,12 L13,7 M21,5 V19</Geometry>
            <Geometry x:Key="StepBackGlyph">M17,18 L11,12 L17,6 M7,6 V18</Geometry>
            <Geometry x:Key="StepForwardGlyph">M7,18 L13,12 L7,6 M17,6 V18</Geometry>
            <Geometry x:Key="PlayGlyph">M8,5.5 A1,1 0 0 1 9.5,4.6 L19,11.1 A1,1 0 0 1 19,12.9 L9.5,19.4 A1,1 0 0 1 8,18.5 Z</Geometry>
            <Geometry x:Key="PauseGlyph">M7,4.5 H10 A1,1 0 0 1 11,5.5 V18.5 A1,1 0 0 1 10,19.5 H7 A1,1 0 0 1 6,18.5 V5.5 A1,1 0 0 1 7,4.5 Z M14,4.5 H17 A1,1 0 0 1 18,5.5 V18.5 A1,1 0 0 1 17,19.5 H14 A1,1 0 0 1 13,18.5 V5.5 A1,1 0 0 1 14,4.5 Z</Geometry>
            <Geometry x:Key="CopyGlyph">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M4,16 V6 A2,2 0 0 1 6,4 H16</Geometry>
            <Geometry x:Key="SaveGlyph">M12,3 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
            <Geometry x:Key="FolderGlyph">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z</Geometry>
            <Geometry x:Key="SparkleGlyph">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 Z</Geometry>
            <Geometry x:Key="PlusGlyph">M12,5 V19 M5,12 H19</Geometry>
            <Geometry x:Key="ExportGlyph">M4,8 H20 M4,16 H20 M9,5 V11 M15,13 V19</Geometry>
            <Geometry x:Key="OverlayGlyph">M4,5 H20 V15 H13 L9,19 V15 H4 Z M8,9 H16 M8,12 H13</Geometry>
            <Geometry x:Key="TimelineZoomGlyph">M10.5,3.5 A7,7 0 1 0 10.5,17.5 A7,7 0 1 0 10.5,3.5 Z M20.5,20.5 L15.5,15.5</Geometry>

            <!-- A square button with only an icon: quiet until the pointer is on it. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Width="34" Height="34" CornerRadius="8" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The big round play button in the middle of the controls. -->
            <Style x:Key="PlayButtonStyle" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackground}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource TextPrimary}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The buttons down the left that choose the panel: an icon over its name (the Tag); the open one has the red bar. -->
            <Style x:Key="RailButton" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Box" Width="62" Height="54" CornerRadius="9" Background="Transparent">
                                    <StackPanel VerticalAlignment="Center">
                                        <ContentPresenter HorizontalAlignment="Center" />
                                        <TextBlock x:Name="Name" Text="{TemplateBinding Tag}" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-5,13,0,13"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The title of a side panel, small and in capitals, like a section of settings. -->
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <!-- A setting on one line: its name, the slider and its value. The name and the value are written by the panel over the
                 margins the slider leaves free. A click anywhere on the bar moves the value there. -->
            <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="local:SliderDrag.Anywhere" Value="True" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="80,0,56,0" />
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- An on/off setting as a switch, with its name on the left. -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource BorderStrong}">
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- "Restablecer" next to a section's title: a link in the accent colour. -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <BooleanToVisibilityConverter x:Key="SectionVisible" />
            <Style x:Key="SubHeader" TargetType="TextBlock" BasedOn="{StaticResource PanelHeader}">
                <Setter Property="Margin" Value="0,18,0,10" />
            </Style>
            <!-- One of two or three words side by side, as parts of one control. -->
            <Style x:Key="SegTile" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" Height="28" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The side panels are quiet: greys, and what is chosen is ringed in the colour of the text. -->
            <!-- A setting as a bar to drag: the whole row is the slider; its name and value are written over it. -->
            <Style x:Key="ScrubPart" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrubFill" TargetType="RepeatButton" BasedOn="{StaticResource ScrubPart}">
                <Setter Property="Background" Value="{DynamicResource Pressed}" />
            </Style>
            <Style x:Key="Scrub" TargetType="Slider">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="local:SliderDrag.Anywhere" Value="True" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Border CornerRadius="8" Background="{DynamicResource Surface}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrubFill}" />
                                    </Track.DecreaseRepeatButton>
                                    <!-- No knob: the end of the fill is the value. -->
                                    <Track.Thumb>
                                        <Thumb Width="0" MinWidth="0" Opacity="0" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrubPart}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrubLabel" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
                <Setter Property="Margin" Value="12,0" />
            </Style>
            <Style x:Key="ScrubValue" TargetType="TextBlock" BasedOn="{StaticResource ScrubLabel}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <!-- The small button beside a bar that opens the rest of its options. -->
            <Style x:Key="MoreToggle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="34" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Box" CornerRadius="8" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A background to choose: a round swatch of it. -->
            <Style x:Key="RoundSwatch" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="1.5" BorderBrush="Transparent" Padding="1.5" Background="Transparent">
                                <Border CornerRadius="11" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#22808080" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A look: a small picture of it; the code rings the one in use through BorderBrush. -->
            <Style x:Key="LookTile" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Ring" Margin="1,0" CornerRadius="8" BorderThickness="1.5" BorderBrush="{TemplateBinding BorderBrush}" Padding="1.5"
                                    Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A colour that can be changed: a round button filled with it. -->
            <Style x:Key="ColorDot" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="QuietSwitch" TargetType="CheckBox">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Track" Width="34" Height="19" CornerRadius="9.5" Background="{DynamicResource BorderStrong}">
                                <Ellipse x:Name="Knob" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource InputBackground}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A choice shown as a drawing: a flat tile, ringed in the colour of the text when chosen. -->
            <Style x:Key="QuietTile" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" CornerRadius="8" BorderThickness="1.5" BorderBrush="Transparent" Background="{DynamicResource Surface}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- An on/off setting as a row: its name, and the quiet switch at the end. The whole row presses it. -->
            <Style x:Key="QuietRow" TargetType="CheckBox">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border Height="34" CornerRadius="8" Padding="12,0,8,0" Background="{DynamicResource Surface}">
                                <DockPanel>
                                    <Border x:Name="Track" DockPanel.Dock="Right" Width="34" Height="19" CornerRadius="9.5" Background="{DynamicResource BorderStrong}">
                                        <Ellipse x:Name="Knob" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource InputBackground}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Something to do, as a row of its own. -->
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Height="34" CornerRadius="8" Background="{DynamicResource Surface}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The name of a group of the panel, with what is chosen written at the other end. -->
            <Style x:Key="GroupName" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Margin" Value="0,20,0,8" />
            </Style>
            <Style x:Key="GroupChoice" TargetType="TextBlock" BasedOn="{StaticResource GroupName}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="Segments" TargetType="Border">
                <Setter Property="Padding" Value="3" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{DynamicResource Surface}" />
            </Style>

            <!-- A choice written in words (Suave, Enfocado), ringed when chosen like the other tiles. -->
            <Style x:Key="WordTile" TargetType="RadioButton" BasedOn="{StaticResource Tile}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Style>
            <!-- A preset in the list: its name, flat until the pointer is on it; a click applies it. -->
            <Style x:Key="PresetRow" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" CornerRadius="8" Background="Transparent" Padding="6,7">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar: undo and redo, the video's name and how it went, and handing the video out -->
        <Grid Height="56" Background="{DynamicResource InputBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="OnUndo" IsEnabled="False" ToolTip="Deshacer (Ctrl+Z)">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource UndoGlyph}" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="OnRedo" IsEnabled="False" ToolTip="Rehacer (Ctrl+Y)">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource RedoGlyph}" />
                </Button>
                <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Click="OnReset" IsEnabled="False" Margin="4,0,0,0"
                        ToolTip="Restablecer: vuelve al video completo, tal como se grabó">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ResetGlyph}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock x:Name="DeliveryText" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ShowInFolderButton" Style="{StaticResource IconButton}" Visibility="Collapsed" Click="OnShowInFolder"
                            Margin="4,-8,0,-8" ToolTip="Mostrar en la carpeta">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource FolderGlyph}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="PresetsButton" Margin="0,0,8,0" Padding="12,6" Focusable="False" Click="OnPresets"
                        ToolTip="Guarda el marco, el cursor y el estilo del zoom con un nombre, y aplícalos a otro video con un clic">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource PresetGlyph}" Margin="0,0,6,0" />
                        <TextBlock Text="Presets" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="PresetsPopup" PlacementTarget="{Binding ElementName=PresetsButton}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" Closed="OnPresetsClosed">
                    <Border Width="320" Margin="0,6,0,0" CornerRadius="12" Padding="14,14,14,12" Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource PanelHeader}" />
                            <TextBlock x:Name="PresetsEmptyText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       Text="Todavía no hay presets. Elige un marco, un cursor y un estilo de zoom, y guárdalos aquí con un nombre." />
                            <StackPanel x:Name="PresetRows" />
                            <TextBlock Text="GUARDAR EL ESTILO ACTUAL" Style="{StaticResource SubHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PresetNameBox" MaxLength="40" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="OnPresetNameKeyDown"
                                         ToolTip="Un nombre para el marco, el cursor y el estilo del zoom de ahora. Si ya existe, se actualiza" />
                                <Button Grid.Column="1" Content="Guardar" Padding="12,5" Focusable="False" Click="OnSavePreset" />
                            </Grid>
                            <TextBlock x:Name="PresetNote" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.8"
                                       Text="Un preset no guarda el recorte, los cortes ni los zooms de este video." />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="CopyButton" Margin="0,0,8,0" Padding="12,6" Focusable="False" IsEnabled="False" Click="OnCopy"
                        ToolTip="Copia el video terminado para pegarlo en un chat o un documento">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource CopyGlyph}" Margin="0,0,6,0" />
                        <TextBlock Text="Copiar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Padding="14,6" Focusable="False" IsDefault="True" IsEnabled="False" Click="OnSave"
                        ToolTip="Guarda el video terminado como archivo; la grabación original no se toca">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource SaveGlyph}" Margin="0,0,6,0" />
                        <TextBlock Text="Guardar…" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- While the finished video is being made: a thin line along the bottom of the bar. -->
            <ProgressBar x:Name="WorkBar" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
        </Grid>

        <!-- the icons, the chosen panel, and the video -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="8,14,0,0">
                <RadioButton x:Name="FrameTab" Tag="Marco" Style="{StaticResource RailButton}" GroupName="sidePanel" IsChecked="True" Checked="OnPanelTab" ToolTip="Marco y fondo">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource FrameGlyph}" />
                </RadioButton>
                <RadioButton x:Name="CursorTab" Tag="Cursor" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Cursor">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource PointerGlyphIcon}" />
                </RadioButton>
                <RadioButton x:Name="ZoomTab" Tag="Zoom" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Zoom">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ZoomGlyph}" />
                </RadioButton>
                <RadioButton x:Name="CropTab" Tag="Recorte" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Recorte">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource CropGlyph}" />
                </RadioButton>
                <RadioButton x:Name="OverlayTab" Tag="Capas" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Desenfoque, texto y flechas">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource OverlayGlyph}" />
                </RadioButton>
                <RadioButton x:Name="ExportTab" Tag="Exportar" Style="{StaticResource RailButton}" GroupName="sidePanel" Checked="OnPanelTab" ToolTip="Exportar: tamaño, calidad y cuadros por segundo">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ExportGlyph}" />
                </RadioButton>
            </StackPanel>

            <Border Grid.Column="1" Margin="4,14,0,12" CornerRadius="12" Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="16,14"
                              PreviewMouseLeftButtonDown="OnPanelRowsDown" PreviewMouseLeftButtonUp="OnPanelRowsUp" LostMouseCapture="OnPanelRowsUp">
                    <Grid>
                        <!-- The frame: a background behind the recording, room around it, rounded corners and a shadow. -->
                        <StackPanel x:Name="FramePanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Marco" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="FrameResetButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,-6,8,-6" Click="OnFrameReset"
                                        AutomationProperties.Name="Restablecer el marco" ToolTip="Restablecer: vuelve a los valores de fábrica del marco">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ResetGlyph}" />
                                </Button>
                                <CheckBox x:Name="FrameBox" Grid.Column="2" Style="{StaticResource QuietSwitch}" Click="OnFrameChanged" AutomationProperties.Name="Poner marco"
                                          ToolTip="Poner marco: el video sobre un fondo, con margen, esquinas redondeadas y sombra. Con zoom, el video crece y el fondo sale de la imagen" />
                            </Grid>
                            <StackPanel x:Name="FrameOptions">
                                <Grid>
                                    <TextBlock Text="Estilo" Style="{StaticResource GroupName}" />
                                    <TextBlock x:Name="FrameLookName" Style="{StaticResource GroupChoice}" />
                                </Grid>
                                <UniformGrid x:Name="FrameLooks" Columns="6" Margin="-2,0" />

                                <Grid>
                                    <TextBlock Text="Fondo" Style="{StaticResource GroupName}" />
                                    <TextBlock x:Name="FrameBackgroundName" Style="{StaticResource GroupChoice}" />
                                </Grid>
                                <!-- One row of backgrounds; the + shows the rest, the colours of one's own, a picture and the slant. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <UniformGrid x:Name="FrameBackgrounds" Columns="7" VerticalAlignment="Top" />
                                    <ToggleButton x:Name="FrameBackgroundMore" Grid.Column="1" Style="{StaticResource MoreToggle}" Width="28" Height="28"
                                                  HorizontalAlignment="Center" Click="OnPanelMore" Tag="background" AutomationProperties.Name="Más fondos"
                                                  ToolTip="Más fondos, colores propios, degradado al azar e imagen">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource PlusGlyph}" />
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="FrameBackgroundExtras" Margin="0,4,0,0"
                                            Visibility="{Binding IsChecked, ElementName=FrameBackgroundMore, Converter={StaticResource SectionVisible}}">
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <Button x:Name="FrameFromButton" Style="{StaticResource ColorDot}" Width="30" Height="30" Click="OnFrameFromColor"
                                                AutomationProperties.Name="Color inicial del fondo" ToolTip="Color inicial del fondo">
                                            <Border x:Name="FrameFromFill" CornerRadius="12" BorderThickness="1" BorderBrush="#40808080" Width="24" Height="24" />
                                        </Button>
                                        <Button x:Name="FrameToButton" Style="{StaticResource ColorDot}" Width="30" Height="30" Click="OnFrameToColor"
                                                AutomationProperties.Name="Color final del fondo" ToolTip="Color final del fondo. Con el mismo color en los dos, el fondo es liso">
                                            <Border x:Name="FrameToFill" CornerRadius="12" BorderThickness="1" BorderBrush="#40808080" Width="24" Height="24" />
                                        </Button>
                                        <Button x:Name="FrameRandomButton" DockPanel.Dock="Right" Content="Al azar" Padding="10,0" Focusable="False" Click="OnFrameRandom"
                                                ToolTip="Un degradado nuevo cada vez" />
                                        <Button x:Name="FrameImageButton" DockPanel.Dock="Right" Content="Imagen…" Padding="10,0" Margin="0,0,6,0" Focusable="False" Click="OnFrameImage"
                                                ToolTip="Usa una imagen de tu disco como fondo" />
                                    </DockPanel>
                                    <Grid x:Name="FrameAngleRow">
                                        <Slider x:Name="FrameAngleSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="345" TickFrequency="15" IsSnapToTickEnabled="True"
                                                SmallChange="15" LargeChange="45" ValueChanged="OnFrameAngle" AutomationProperties.Name="Ángulo" ToolTip="Hacia dónde corre el degradado" />
                                        <TextBlock Text="Ángulo" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="FrameAngleText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Ajustes" Style="{StaticResource GroupName}" />
                                <!-- Every row leaves the same room at the right for its button, so the bars line up. -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Margin="0,0,36,0">
                                        <Grid x:Name="FramePaddingRow">
                                            <Slider x:Name="FramePaddingSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.15" SmallChange="0.005" LargeChange="0.02"
                                                    ValueChanged="OnFrameSlider" AutomationProperties.Name="Relleno" ToolTip="El espacio de fondo alrededor del video" />
                                            <TextBlock Text="Relleno" Style="{StaticResource ScrubLabel}" />
                                            <TextBlock x:Name="FramePaddingText" Style="{StaticResource ScrubValue}" />
                                        </Grid>
                                        <StackPanel x:Name="FrameSidesPanel" Visibility="Collapsed">
                                            <Grid Margin="0,0,0,6">
                                                <Slider x:Name="FrameTopSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.3" SmallChange="0.005" LargeChange="0.02"
                                                        ValueChanged="OnFrameSlider" AutomationProperties.Name="Relleno arriba" ToolTip="El espacio sobre el video" />
                                                <TextBlock Text="Relleno arriba" Style="{StaticResource ScrubLabel}" />
                                                <TextBlock x:Name="FrameTopText" Style="{StaticResource ScrubValue}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Slider x:Name="FrameBottomSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.3" SmallChange="0.005" LargeChange="0.02"
                                                        ValueChanged="OnFrameSlider" AutomationProperties.Name="Relleno abajo" ToolTip="El espacio bajo el video" />
                                                <TextBlock Text="Relleno abajo" Style="{StaticResource ScrubLabel}" />
                                                <TextBlock x:Name="FrameBottomText" Style="{StaticResource ScrubValue}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Slider x:Name="FrameLeftSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.3" SmallChange="0.005" LargeChange="0.02"
                                                        ValueChanged="OnFrameSlider" AutomationProperties.Name="Relleno izquierda" ToolTip="El espacio a la izquierda del video" />
                                                <TextBlock Text="Relleno izquierda" Style="{StaticResource ScrubLabel}" />
                                                <TextBlock x:Name="FrameLeftText" Style="{StaticResource ScrubValue}" />
                                            </Grid>
                                            <Grid>
                                                <Slider x:Name="FrameRightSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.3" SmallChange="0.005" LargeChange="0.02"
                                                        ValueChanged="OnFrameSlider" AutomationProperties.Name="Relleno derecha" ToolTip="El espacio a la derecha del video" />
                                                <TextBlock Text="Relleno derecha" Style="{StaticResource ScrubLabel}" />
                                                <TextBlock x:Name="FrameRightText" Style="{StaticResource ScrubValue}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox x:Name="FrameSidesBox" Style="{StaticResource MoreToggle}" Click="OnFrameChanged" AutomationProperties.Name="Relleno por lado"
                                              ToolTip="Relleno por lado: da a cada lado su propio espacio, por ejemplo más abajo para poner subtítulos">
                                        <Path Style="{StaticResource Glyph}" Data="M8,4 H16 M20,8 V16 M16,20 H8 M4,16 V8" />
                                    </CheckBox>
                                </Grid>
                                <Grid Margin="0,0,36,6">
                                    <Slider x:Name="FrameRadiusSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.05" SmallChange="0.002" LargeChange="0.01"
                                            ValueChanged="OnFrameSlider" AutomationProperties.Name="Radio" ToolTip="Cuán redondeadas son las esquinas del video" />
                                    <TextBlock Text="Radio" Style="{StaticResource ScrubLabel}" />
                                    <TextBlock x:Name="FrameRadiusText" Style="{StaticResource ScrubValue}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid Margin="0,0,36,0">
                                        <Slider x:Name="FrameShadowSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                                                ValueChanged="OnFrameSlider" AutomationProperties.Name="Sombra" ToolTip="Cuán oscura es la sombra bajo el video" />
                                        <TextBlock Text="Sombra" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="FrameShadowText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                    <ToggleButton x:Name="FrameShadowMore" Style="{StaticResource MoreToggle}" Click="OnPanelMore" Tag="shadow"
                                                  AutomationProperties.Name="Más opciones de la sombra" ToolTip="Desenfoque, distancia y color de la sombra">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource ExportGlyph}" />
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="FrameShadowDetails" Margin="14,0,36,0"
                                            Visibility="{Binding IsChecked, ElementName=FrameShadowMore, Converter={StaticResource SectionVisible}}">
                                    <Grid Margin="0,0,0,6">
                                        <Slider x:Name="FrameShadowBlurSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.08" SmallChange="0.002" LargeChange="0.01"
                                                ValueChanged="OnFrameSlider" AutomationProperties.Name="Desenfoque" ToolTip="Cuán difusa es la sombra: poco es un borde marcado, mucho un resplandor" />
                                        <TextBlock Text="Desenfoque" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="FrameShadowBlurText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Slider x:Name="FrameShadowOffsetSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.04" SmallChange="0.001" LargeChange="0.005"
                                                ValueChanged="OnFrameSlider" AutomationProperties.Name="Distancia" ToolTip="Cuánto se desplaza la sombra hacia abajo" />
                                        <TextBlock Text="Distancia" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="FrameShadowOffsetText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                    <Border Height="34" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Surface}">
                                        <Grid>
                                            <TextBlock Text="Color" Style="{StaticResource ScrubLabel}" />
                                            <Button x:Name="FrameShadowColorButton" Style="{StaticResource ColorDot}" Width="34" Height="34" HorizontalAlignment="Right" Click="OnFrameShadowColor"
                                                    AutomationProperties.Name="Color de la sombra" ToolTip="Color de la sombra">
                                                <Border x:Name="FrameShadowFill" CornerRadius="10" BorderThickness="1" BorderBrush="#60808080" Width="20" Height="20" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid Margin="0,0,36,0">
                                        <Slider x:Name="FrameBorderSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.008" SmallChange="0.0005" LargeChange="0.002"
                                                ValueChanged="OnFrameSlider" AutomationProperties.Name="Borde" ToolTip="El grosor de la línea que rodea el video. En 0 no hay borde" />
                                        <TextBlock Text="Borde" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="FrameBorderText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                    <ToggleButton x:Name="FrameBorderMore" Style="{StaticResource MoreToggle}" Click="OnPanelMore" Tag="border"
                                                  AutomationProperties.Name="Más opciones del borde" ToolTip="Color del borde">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource ExportGlyph}" />
                                    </ToggleButton>
                                </Grid>
                                <Border Height="34" Margin="14,0,36,6" CornerRadius="8" Background="{DynamicResource Surface}"
                                        Visibility="{Binding IsChecked, ElementName=FrameBorderMore, Converter={StaticResource SectionVisible}}">
                                    <Grid>
                                        <TextBlock Text="Color" Style="{StaticResource ScrubLabel}" />
                                        <Button x:Name="FrameBorderColorButton" Style="{StaticResource ColorDot}" Width="34" Height="34" HorizontalAlignment="Right" Click="OnFrameBorderColor"
                                                AutomationProperties.Name="Color del borde" ToolTip="Color del borde">
                                            <Border x:Name="FrameBorderFill" CornerRadius="10" BorderThickness="1" BorderBrush="#60808080" Width="20" Height="20" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Barra de ventana" Style="{StaticResource GroupName}" />
                                <Border Style="{StaticResource Segments}">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="FrameBarNone" Style="{StaticResource SegTile}" GroupName="frameBar" Content="Ninguna" Checked="OnFrameChanged" ToolTip="Sin barra: solo el video" />
                                        <RadioButton x:Name="FrameBarMac" Style="{StaticResource SegTile}" GroupName="frameBar" Content="Mac" Checked="OnFrameChanged"
                                                     ToolTip="Una barra con tres botones redondos a la izquierda, como en macOS" />
                                        <RadioButton x:Name="FrameBarWindows" Style="{StaticResource SegTile}" GroupName="frameBar" Content="Windows" Checked="OnFrameChanged"
                                                     ToolTip="Una barra con minimizar, maximizar y cerrar a la derecha, como en Windows" />
                                    </UniformGrid>
                                </Border>
                                <!-- The tone is of the bar: there is nothing to choose without one. -->
                                <Border x:Name="FrameBarToneBox" Style="{StaticResource Segments}" Margin="0,6,0,0">
                                    <UniformGrid x:Name="FrameBarToneRow" Columns="2">
                                        <RadioButton x:Name="FrameBarDark" Style="{StaticResource SegTile}" GroupName="frameBarTone" Content="Oscura" Checked="OnFrameChanged" ToolTip="Barra de tonos oscuros" />
                                        <RadioButton x:Name="FrameBarLight" Style="{StaticResource SegTile}" GroupName="frameBarTone" Content="Clara" Checked="OnFrameChanged" ToolTip="Barra de tonos claros" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- The pointer: the video is recorded without it, and the one drawn here goes into the saved video. -->
                        <StackPanel x:Name="CursorPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cursor" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="CursorResetButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,-6,8,-6" Click="OnCursorReset"
                                        AutomationProperties.Name="Restablecer el cursor" ToolTip="Restablecer: vuelve a los valores de fábrica del cursor">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ResetGlyph}" />
                                </Button>
                                <CheckBox x:Name="CursorBox" Grid.Column="2" Style="{StaticResource QuietSwitch}" Click="OnCursorChanged" AutomationProperties.Name="Mostrar cursor"
                                          ToolTip="Mostrar cursor: dibuja el puntero en el video, más grande, con movimiento suave y un efecto en cada clic" />
                            </Grid>
                            <TextBlock x:Name="CursorNote" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Visibility="Collapsed" />
                            <StackPanel x:Name="CursorOptions">
                                <Grid>
                                    <TextBlock Text="Estilo" Style="{StaticResource GroupName}" />
                                    <TextBlock x:Name="CursorShapeName" Style="{StaticResource GroupChoice}" />
                                </Grid>
                                <UniformGrid x:Name="CursorShapes" Columns="3" Margin="0,0,-6,6" />
                                <Grid>
                                    <Slider x:Name="CursorSizeSlider" Style="{StaticResource Scrub}" Minimum="1" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                            ValueChanged="OnCursorSlider" AutomationProperties.Name="Tamaño" ToolTip="Cuántas veces más grande que el puntero en la pantalla" />
                                    <TextBlock Text="Tamaño" Style="{StaticResource ScrubLabel}" />
                                    <TextBlock x:Name="CursorSizeText" Style="{StaticResource ScrubValue}" />
                                </Grid>

                                <TextBlock Text="Movimiento" Style="{StaticResource GroupName}" />
                                <Grid Margin="0,0,0,6">
                                    <Border Style="{StaticResource Segments}" Margin="0,0,36,0">
                                        <UniformGrid Columns="3">
                                            <RadioButton x:Name="CursorNaturalTile" Style="{StaticResource SegTile}" GroupName="cursorMotion" Content="Natural" Click="OnCursorMotion"
                                                         ToolTip="El puntero va exactamente como lo moviste" />
                                            <RadioButton x:Name="CursorSmoothTile" Style="{StaticResource SegTile}" GroupName="cursorMotion" Content="Suave" Click="OnCursorMotion"
                                                         ToolTip="Sin temblores y con un leve balanceo" />
                                            <RadioButton x:Name="CursorCinematicTile" Style="{StaticResource SegTile}" GroupName="cursorMotion" Content="Cinemático" Click="OnCursorMotion"
                                                         ToolTip="Se desliza mucho y se inclina al moverse: para demostraciones" />
                                        </UniformGrid>
                                    </Border>
                                    <ToggleButton x:Name="CursorMotionMore" Style="{StaticResource MoreToggle}" VerticalAlignment="Center" Click="OnPanelMore" Tag="motion"
                                                  AutomationProperties.Name="Más opciones del movimiento" ToolTip="Ajustar el suavizado y el balanceo">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource ExportGlyph}" />
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="CursorMotionDetails" Margin="14,0,36,0"
                                            Visibility="{Binding IsChecked, ElementName=CursorMotionMore, Converter={StaticResource SectionVisible}}">
                                    <Grid Margin="0,0,0,6">
                                        <Slider x:Name="CursorSmoothingSlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25"
                                                ValueChanged="OnCursorSlider" AutomationProperties.Name="Suavizado" ToolTip="Quita el temblor de la mano: el puntero se desliza en lugar de saltar" />
                                        <TextBlock Text="Suavizado" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="CursorSmoothingText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                    <Grid x:Name="CursorSwayRow" Margin="0,0,0,6" Background="Transparent" ToolTipService.ShowOnDisabled="True">
                                        <Slider x:Name="CursorSwaySlider" Style="{StaticResource Scrub}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25"
                                                ValueChanged="OnCursorSlider" AutomationProperties.Name="Balanceo" />
                                        <TextBlock Text="Balanceo" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="CursorSwayText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                </StackPanel>
                                <CheckBox x:Name="CursorIdleBox" Content="Ocultar si no se mueve" Style="{StaticResource QuietRow}" Click="OnCursorChanged"
                                          ToolTip="Tras 2 segundos quieto, el puntero se desvanece; vuelve justo cuando se mueve" />

                                <Grid>
                                    <TextBlock Text="Efecto de clic" Style="{StaticResource GroupName}" />
                                    <TextBlock x:Name="CursorClickName" Style="{StaticResource GroupChoice}" />
                                </Grid>
                                <UniformGrid x:Name="CursorClicks" Columns="3" Margin="0,0,-6,0" />
                                <StackPanel x:Name="CursorTints" Orientation="Horizontal" Margin="0,8,0,6" />
                                <CheckBox x:Name="CursorBounceBox" Content="Rebote al hacer clic" Style="{StaticResource QuietRow}" Click="OnCursorChanged"
                                          ToolTip="El puntero se encoge un instante en cada clic, como si se presionara" />
                                <CheckBox x:Name="CursorHaloBox" Content="Halo alrededor del cursor" Style="{StaticResource QuietRow}" Click="OnCursorChanged"
                                          ToolTip="Un círculo del color elegido acompaña siempre al puntero, para seguirlo con la vista" />
                            </StackPanel>
                        </StackPanel>

                        <!-- The crop: what is cut from each side of the picture (the taskbar, a browser's tabs). It belongs to this
                             video, so it is undone with the edit and not remembered for the next one. -->
                        <StackPanel x:Name="CropPanel" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="Recorte" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="CropResetButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,-6" Visibility="Hidden" Click="OnCropReset"
                                        AutomationProperties.Name="Quitar el recorte" ToolTip="Restablecer: vuelve a la imagen completa (se puede deshacer)">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ResetGlyph}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Quitar de cada lado" Style="{StaticResource GroupName}" />
                            <StackPanel x:Name="CropOptions">
                                <Grid Margin="0,0,0,6">
                                    <Slider x:Name="CropTopSlider" Tag="{x:Static local:CropEdges.Top}" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" AutomationProperties.Name="Superior" ToolTip="Cuánto se quita de arriba, por ejemplo las pestañas del navegador" />
                                    <TextBlock Text="Superior" Style="{StaticResource ScrubLabel}" />
                                    <TextBlock x:Name="CropTopText" Style="{StaticResource ScrubValue}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Slider x:Name="CropBottomSlider" Tag="{x:Static local:CropEdges.Bottom}" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" AutomationProperties.Name="Inferior" ToolTip="Cuánto se quita de abajo, por ejemplo la barra de tareas" />
                                    <TextBlock Text="Inferior" Style="{StaticResource ScrubLabel}" />
                                    <TextBlock x:Name="CropBottomText" Style="{StaticResource ScrubValue}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Slider x:Name="CropLeftSlider" Tag="{x:Static local:CropEdges.Left}" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" AutomationProperties.Name="Izquierda" ToolTip="Cuánto se quita de la izquierda" />
                                    <TextBlock Text="Izquierda" Style="{StaticResource ScrubLabel}" />
                                    <TextBlock x:Name="CropLeftText" Style="{StaticResource ScrubValue}" />
                                </Grid>
                                <Grid>
                                    <Slider x:Name="CropRightSlider" Tag="{x:Static local:CropEdges.Right}" Style="{StaticResource Scrub}" Minimum="0" Maximum="0.5"
                                            SmallChange="0.005" LargeChange="0.05" ValueChanged="OnCropSlider" AutomationProperties.Name="Derecha" ToolTip="Cuánto se quita de la derecha" />
                                    <TextBlock Text="Derecha" Style="{StaticResource ScrubLabel}" />
                                    <TextBlock x:Name="CropRightText" Style="{StaticResource ScrubValue}" />
                                </Grid>
                            </StackPanel>
                            <TextBlock x:Name="CropSizeText" HorizontalAlignment="Center" FontSize="12" Margin="0,12,0,0" />
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,16,0,0"
                                       Text="También puedes arrastrar el rectángulo sobre el video: sus bordes, esquinas o el centro. Al reproducir o cambiar de panel se ve el resultado." />
                        </StackPanel>

                        <!-- The zooms: suggested from the clicks or added by hand; the chosen one can be changed here. -->
                        <StackPanel x:Name="ZoomPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Zoom" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="ZoomStyleResetButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,-6" Click="OnZoomStyleReset"
                                        AutomationProperties.Name="Restablecer el estilo del zoom" ToolTip="Restablecer: vuelve a 1,5×, movimiento suave, zooms conectados y siguiendo al cursor">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource ResetGlyph}" />
                                </Button>
                            </Grid>
                            <Button x:Name="AutoZoomButton" Style="{StaticResource QuietButton}" IsEnabled="False" Click="OnAutoZoom">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource SparkleGlyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="Zoom automático" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddZoomButton" Style="{StaticResource QuietButton}" IsEnabled="False" Click="OnAddZoom"
                                    ToolTip="Añade un zoom donde está la línea roja (Z). También con doble clic en la fila de zooms">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource PlusGlyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="Añadir zoom aquí" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Muévelos o alárgalos en la fila de zooms de la línea de tiempo." />

                            <!-- The chosen zoom comes before the style of them all: it is what was just clicked. -->
                            <StackPanel x:Name="ZoomDetails" Visibility="Collapsed">
                                <TextBlock Text="Zoom elegido" Style="{StaticResource GroupName}" />
                                <Border Style="{StaticResource Segments}">
                                    <UniformGrid x:Name="ZoomDepthBox" Columns="6" ToolTip="Cuánto se acerca este zoom">
                                        <RadioButton Style="{StaticResource SegTile}" GroupName="zoomDepth" Content="1,25×" Tag="1.25" Checked="OnZoomDepthChanged" />
                                        <RadioButton Style="{StaticResource SegTile}" GroupName="zoomDepth" Content="1,5×" Tag="1.5" Checked="OnZoomDepthChanged" />
                                        <RadioButton Style="{StaticResource SegTile}" GroupName="zoomDepth" Content="1,8×" Tag="1.8" Checked="OnZoomDepthChanged" />
                                        <RadioButton Style="{StaticResource SegTile}" GroupName="zoomDepth" Content="2×" Tag="2" Checked="OnZoomDepthChanged" />
                                        <RadioButton Style="{StaticResource SegTile}" GroupName="zoomDepth" Content="2,5×" Tag="2.5" Checked="OnZoomDepthChanged" />
                                        <RadioButton Style="{StaticResource SegTile}" GroupName="zoomDepth" Content="3×" Tag="3" Checked="OnZoomDepthChanged" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="Haz clic o arrastra en el video para elegir adónde mira." Foreground="{DynamicResource TextSecondary}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,8" />
                                <Button x:Name="DeleteZoomButton" Style="{StaticResource QuietButton}" Click="OnDeleteZoom" ToolTip="Quita el zoom elegido (Supr)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource TrashGlyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="Quitar zoom" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Estilo de los zooms" Style="{StaticResource GroupName}" />
                            <Grid Margin="0,0,0,6">
                                <Slider x:Name="ZoomStyleDepthSlider" Style="{StaticResource Scrub}" Minimum="1.1" Maximum="3" SmallChange="0.05" LargeChange="0.25"
                                        ValueChanged="OnZoomStyleSlider" AutomationProperties.Name="Acercar" ToolTip="Cuánto acercan los zooms de este video y los que se añadan" />
                                <TextBlock Text="Acercar" Style="{StaticResource ScrubLabel}" />
                                <TextBlock x:Name="ZoomStyleDepthText" Style="{StaticResource ScrubValue}" />
                            </Grid>
                            <Border Style="{StaticResource Segments}" Margin="0,0,0,6">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="ZoomSmoothTile" Style="{StaticResource SegTile}" GroupName="zoomMotion" Content="Suave" Click="OnZoomStyleChanged"
                                                 ToolTip="Entra y sale despacio (1,5 s): para presentaciones" />
                                    <RadioButton x:Name="ZoomFocusedTile" Style="{StaticResource SegTile}" GroupName="zoomMotion" Content="Enfocado" Click="OnZoomStyleChanged"
                                                 ToolTip="Entra y sale rápido (0,8 s): para tutoriales de clic en clic" />
                                </UniformGrid>
                            </Border>
                            <CheckBox x:Name="ZoomConnectBox" Content="Conectar zooms seguidos" Style="{StaticResource QuietRow}" Click="OnZoomStyleChanged"
                                      ToolTip="Si dos zooms están cerca, la cámara se desliza del uno al otro sin volver a la pantalla completa" />
                            <CheckBox x:Name="ZoomFollowBox" Content="Seguir al cursor" Style="{StaticResource QuietRow}" Click="OnZoomStyleChanged"
                                      ToolTip="Con zoom, la cámara acompaña al puntero para que no salga de la vista" />
                            <CheckBox x:Name="ZoomBlurBox" Content="Desenfoque al moverse" Style="{StaticResource QuietRow}" Click="OnZoomStyleChanged"
                                      ToolTip="La cámara y el cursor se difuminan cuando van rápido. Se ve en el video guardado, no en esta vista" />
                        </StackPanel>

                        <!-- The overlays: a blur to hide something, a text, an arrow. Drawn on the picture; each one shows for a stretch
                             of time, set in its own row of the timeline. -->
                        <StackPanel x:Name="OverlayPanel" Visibility="Collapsed">
                            <TextBlock Text="Capas" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <UniformGrid Columns="3" Margin="0,0,-6,0">
                                <RadioButton x:Name="BlurToolTile" Style="{StaticResource QuietTile}" Height="56" GroupName="overlayTool" Tag="Blur"
                                             Click="OnOverlayTool" AutomationProperties.Name="Desenfocar" ToolTip="Oculta una zona del video: una contraseña, un correo, datos de un cliente">
                                    <StackPanel>
                                        <Path Style="{StaticResource Glyph}" Data="M12,3 C15,7.5 18,10.5 18,14.5 A6,6 0 0 1 6,14.5 C6,10.5 9,7.5 12,3 Z M9.5,15 A2.5,2.5 0 0 0 12,17.5" HorizontalAlignment="Center" />
                                        <TextBlock Text="Desenfocar" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TextToolTile" Style="{StaticResource QuietTile}" Height="56" GroupName="overlayTool" Tag="Text"
                                             Click="OnOverlayTool" AutomationProperties.Name="Texto" ToolTip="Escribe un texto sobre el video">
                                    <StackPanel>
                                        <Path Style="{StaticResource Glyph}" Data="M5,7 V5 H19 V7 M12,5 V19 M9,19 H15" HorizontalAlignment="Center" />
                                        <TextBlock Text="Texto" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ArrowToolTile" Style="{StaticResource QuietTile}" Height="56" GroupName="overlayTool" Tag="Arrow"
                                             Click="OnOverlayTool" AutomationProperties.Name="Flecha" ToolTip="Señala algo con una flecha">
                                    <StackPanel>
                                        <Path Style="{StaticResource Glyph}" Data="M5,19 L19,5 M9,5 H19 V15" HorizontalAlignment="Center" />
                                        <TextBlock Text="Flecha" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock x:Name="OverlayHint" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Elige una herramienta y haz clic o arrastra sobre el video: la capa empieza en la línea roja y dura 3 segundos. Muévela o alárgala en la línea de tiempo." />
                            <StackPanel x:Name="OverlayDetails" Visibility="Collapsed">
                                <TextBlock x:Name="OverlayDetailsTitle" Style="{StaticResource GroupName}" />
                                <StackPanel x:Name="OverlayTextBlock">
                                    <TextBox x:Name="OverlayTextBox" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="120" MinHeight="58" VerticalContentAlignment="Top"
                                             Background="{DynamicResource Surface}" BorderBrush="Transparent"
                                             TextChanged="OnOverlayTextChanged" LostKeyboardFocus="OnOverlayTextLostFocus" AutomationProperties.Name="Texto de la capa" ToolTip="Lo que dice el texto" />
                                </StackPanel>
                                <StackPanel x:Name="OverlayInkBlock">
                                    <TextBlock Text="Color" Style="{StaticResource GroupName}" />
                                    <WrapPanel x:Name="OverlayInks" />
                                    <Grid Margin="0,6,0,0">
                                        <Slider x:Name="OverlaySizeSlider" Style="{StaticResource Scrub}" Minimum="0.01" Maximum="0.15" SmallChange="0.002" LargeChange="0.02"
                                                ValueChanged="OnOverlaySizeChanged" AutomationProperties.Name="Tamaño" />
                                        <TextBlock x:Name="OverlaySizeLabel" Text="Tamaño" Style="{StaticResource ScrubLabel}" />
                                        <TextBlock x:Name="OverlaySizeText" Style="{StaticResource ScrubValue}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="OverlayBlurNote" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap"
                                           Text="Arrastra el rectángulo sobre el video para moverlo, o sus esquinas para cambiar su tamaño. El desenfoque aparece y desaparece de golpe, para que no se vea nada un instante." />
                                <Button x:Name="DeleteOverlayButton" Style="{StaticResource QuietButton}" Margin="0,12,0,0" Click="OnDeleteOverlay" ToolTip="Quita la capa elegida (Supr)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource TrashGlyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="Quitar capa" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- How the finished video is written: size, quality and pictures a second. Not an edit: nothing to undo. -->
                        <StackPanel x:Name="ExportPanel" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="EXPORTAR" Style="{StaticResource PanelHeader}" />
                                <Button x:Name="ExportResetButton" Content="Restablecer" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="OnExportReset" ToolTip="Vuelve al tamaño y la calidad de la grabación" />
                            </Grid>
                            <TextBlock Text="Formato" Style="{StaticResource SubHeader}" />
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="AspectOriginalTile" Style="{StaticResource WordTile}" GroupName="exportAspect" Content="Original" Click="OnAspectChanged"
                                             ToolTip="La forma de la grabación" />
                                <RadioButton x:Name="AspectWideTile" Style="{StaticResource WordTile}" GroupName="exportAspect" Content="16:9" Click="OnAspectChanged"
                                             ToolTip="Horizontal: videos, presentaciones" />
                                <RadioButton x:Name="AspectTallTile" Style="{StaticResource WordTile}" GroupName="exportAspect" Content="9:16" Click="OnAspectChanged"
                                             ToolTip="Vertical: historias, reels, shorts" />
                                <RadioButton x:Name="AspectSquareTile" Style="{StaticResource WordTile}" GroupName="exportAspect" Content="1:1" Click="OnAspectChanged"
                                             Margin="0" ToolTip="Cuadrado: publicaciones" />
                            </UniformGrid>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Con otro formato la grabación queda en el centro, sobre el fondo del Marco. Es de este video y se puede deshacer." />

                            <TextBlock Text="Tamaño" Style="{StaticResource SubHeader}" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="ResolutionOriginalTile" Style="{StaticResource WordTile}" GroupName="exportResolution" Content="Original" Click="OnExportChanged" Margin="0,0,6,6"
                                             ToolTip="El tamaño de la grabación (o de su recorte)" />
                                <RadioButton x:Name="ResolutionHighTile" Style="{StaticResource WordTile}" GroupName="exportResolution" Content="Alta" Click="OnExportChanged" Margin="0,0,0,6"
                                             ToolTip="El 90 % de cada lado" />
                                <RadioButton x:Name="ResolutionMediumTile" Style="{StaticResource WordTile}" GroupName="exportResolution" Content="Media" Click="OnExportChanged"
                                             ToolTip="El 75 % de cada lado" />
                                <RadioButton x:Name="ResolutionLowTile" Style="{StaticResource WordTile}" GroupName="exportResolution" Content="Baja" Click="OnExportChanged"
                                             Margin="0" ToolTip="La mitad de cada lado: un archivo pequeño para enviar" />
                            </UniformGrid>
                            <TextBlock x:Name="ExportSizeText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <TextBlock Text="Calidad" Style="{StaticResource SubHeader}" />
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="QualityLightTile" Style="{StaticResource WordTile}" GroupName="exportQuality" Content="Ligera" Click="OnExportChanged"
                                             ToolTip="Archivo pequeño; el texto se ve un poco más suave" />
                                <RadioButton x:Name="QualityBalancedTile" Style="{StaticResource WordTile}" GroupName="exportQuality" Content="Normal" Click="OnExportChanged"
                                             ToolTip="Lo que Zarpazo siempre guardó" />
                                <RadioButton x:Name="QualityHighTile" Style="{StaticResource WordTile}" GroupName="exportQuality" Content="Alta" Click="OnExportChanged"
                                             Margin="0" ToolTip="Archivo más pesado; el texto se ve más nítido" />
                            </UniformGrid>

                            <TextBlock Text="Cuadros por segundo" Style="{StaticResource SubHeader}" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="FpsAutoTile" Style="{StaticResource WordTile}" GroupName="exportFps" Content="Como la grabación" Click="OnExportChanged" Margin="0,0,6,6" />
                                <RadioButton x:Name="Fps24Tile" Style="{StaticResource WordTile}" GroupName="exportFps" Content="24" Click="OnExportChanged" Margin="0,0,0,6" />
                                <RadioButton x:Name="Fps30Tile" Style="{StaticResource WordTile}" GroupName="exportFps" Content="30" Click="OnExportChanged" />
                                <RadioButton x:Name="Fps60Tile" Style="{StaticResource WordTile}" GroupName="exportFps" Content="60" Click="OnExportChanged" Margin="0" />
                            </UniformGrid>

                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Se aplica al guardar o copiar. Si la grabación tiene menos cuadros de los que eliges, se conservan los suyos." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2" Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The scene is drawn at the video's own size inside the Viewbox, so the zoom and the frame are worked out in its pixels.
                     The camera (the zoom) moves the Scene; the frame is its backdrop and the place of the recording in it. -->
                <Border Background="Black" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox x:Name="StageBox" Stretch="Uniform" SizeChanged="OnStageBoxSizeChanged">
                        <Grid x:Name="Stage" ClipToBounds="True" Background="Black"
                              MouseLeftButtonDown="OnStageMouseDown" MouseMove="OnStageMouseMove" MouseLeftButtonUp="OnStageMouseUp">
                            <Grid x:Name="Scene">
                                <!-- The frame's backdrop, live (a gradient and a card with the shadow): a slider changes only what the graphics
                                     card draws, so it follows the hand. The saved video draws the same with FrameBackdrop. -->
                                <Grid x:Name="Backdrop" Visibility="Collapsed">
                                    <Border x:Name="BackdropFill" />
                                    <Border x:Name="ShadowCard" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black" />
                                </Grid>
                                <!-- The recording at its own size; a crop shifts it so the part kept starts at the corner, and the
                                     host's clip hides the rest: all of it done by the graphics card. -->
                                <Grid x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Canvas>
                                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                                      Stretch="Fill" IsMuted="False" MediaOpened="OnOpened" MediaFailed="OnFailed" MediaEnded="OnMediaEnded" />
                                    </Canvas>
                                    <!-- The blurs, texts and arrows, in the recording's pixels, so the zoom and the frame carry them along. -->
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                                </Grid>
                                <!-- The frame's title bar above the recording, and the line along the card's edge over it. -->
                                <Border x:Name="BarHost" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="FrameRing" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />

                            </Grid>
                            <!-- The pointer the saved video will have, drawn over the scene where the camera shows it (not zoomed with
                                 the picture, so it stays sharp), with the effects of the clicks under it. -->
                            <Canvas x:Name="PointerLayer" IsHitTestVisible="False" Visibility="Collapsed">
                                <Canvas x:Name="ClickMarks" />
                                <Canvas x:Name="PointerGlyph">
                                    <Canvas.Effect>
                                        <DropShadowEffect ShadowDepth="1.6" Direction="270" BlurRadius="4" Opacity="0.4" />
                                    </Canvas.Effect>
                                    <Path x:Name="PointerEdge" StrokeLineJoin="Round" />
                                    <Path x:Name="PointerFill" />
                                </Canvas>
                            </Canvas>
                            <!-- While the crop panel is open: the whole recording, dimmed outside what is kept, with a rectangle
                                 whose sides, corners and middle can be dragged. -->
                            <Canvas x:Name="CropLayer" Visibility="Collapsed" IsHitTestVisible="False">
                                <Path x:Name="CropShade" Fill="#A6000000" />
                                <Rectangle x:Name="CropFrame" Stroke="White" />
                                <Canvas x:Name="CropHandles" />
                            </Canvas>
                            <!-- While a zoom is chosen: the whole picture, dimmed outside what the zoom will show. -->
                            <Canvas x:Name="FocusLayer" Visibility="Collapsed" IsHitTestVisible="False">
                                <Path x:Name="FocusShade" Fill="#99000000" />
                                <Rectangle x:Name="FocusFrame" Stroke="#8E6CEF" />
                                <Ellipse x:Name="FocusDot" Fill="#8E6CEF" Stroke="White" />
                            </Canvas>
                            <!-- While the overlays panel is open: the outline and the handles of the chosen one, drawn over the scene
                                 (not zoomed with the picture) so the handles keep their size. -->
                            <Canvas x:Name="OverlayHandles" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- The controls under the video: tools for the chosen piece on the left, playing in the middle, the timeline's zoom on the right. -->
                <Grid Grid.Row="1" Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="2,1" CornerRadius="10" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SplitButton" Style="{StaticResource IconButton}" Click="OnSplit" IsEnabled="False"
                                ToolTip="Dividir: corta la parte donde está la línea roja (S)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource SplitGlyph}" />
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="OnDelete" IsEnabled="False"
                                ToolTip="Eliminar la parte seleccionada; las siguientes se juntan (Supr)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource TrashGlyph}" />
                        </Button>
                        <Button x:Name="DuplicateButton" Style="{StaticResource IconButton}" Click="OnDuplicate" IsEnabled="False"
                                ToolTip="Duplicar la parte seleccionada justo después (Ctrl+D)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource DuplicateGlyph}" />
                        </Button>
                        <Border Width="1" Height="18" Margin="3,0" Background="{DynamicResource Border}" />
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Click="OnMute" IsEnabled="False"
                                ToolTip="Silenciar la parte seleccionada (M)">
                            <Path x:Name="MuteIcon" Style="{StaticResource Glyph}" Data="{StaticResource SoundGlyph}" />
                        </Button>
                        <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" Click="OnSpeedButton" IsEnabled="False"
                                ToolTip="Velocidad de la parte seleccionada: más rápida para lo que es largo, más lenta para lo que pasa rápido">
                            <TextBlock x:Name="SpeedText" Text="1×" FontSize="11" FontWeight="SemiBold" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SpeedMenu" Placement="Top" Opened="OnSpeedMenuOpened" />
                            </Button.ContextMenu>
                        </Button>
                        <Border Width="1" Height="18" Margin="3,0" Background="{DynamicResource Border}" />
                        <Button x:Name="MoveLeftButton" Style="{StaticResource IconButton}" Click="OnMoveLeft" IsEnabled="False"
                                ToolTip="Pasar la parte seleccionada antes de la anterior (Alt+←). También se arrastra por su título">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource MoveLeftGlyph}" />
                        </Button>
                        <Button x:Name="MoveRightButton" Style="{StaticResource IconButton}" Click="OnMoveRight" IsEnabled="False"
                                ToolTip="Pasar la parte seleccionada después de la siguiente (Alt+→)">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource MoveRightGlyph}" />
                        </Button>
                    </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="OnStepBack" IsEnabled="False"
                                ToolTip="Un cuadro atrás (←). Con Mayús, un segundo">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource StepBackGlyph}" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Margin="6,0" Click="OnPlay" IsEnabled="False"
                                ToolTip="Reproducir lo que quedará (Espacio)">
                            <Path x:Name="PlayIcon" Style="{StaticResource FilledGlyph}" Data="{StaticResource PlayGlyph}" />
                        </Button>
                        <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="OnStepForward" IsEnabled="False"
                                ToolTip="Un cuadro adelante (→). Con Mayús, un segundo">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource StepForwardGlyph}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="PositionText" Width="112" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondary}" />
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource TimelineZoomGlyph}" Stroke="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                        <Slider x:Name="ZoomSlider" Width="110" Minimum="1" Maximum="24" Value="1" IsEnabled="False" ValueChanged="OnZoomChanged"
                                VerticalAlignment="Center" Focusable="False" ToolTip="Acerca la línea de tiempo (Ctrl + rueda del ratón)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- the timeline, the whole width, and a line about the edit -->
        <StackPanel Grid.Row="2" Margin="16,0,16,12">
            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="0,0,0,2">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnTimelineWheel" SizeChanged="OnScrollerSizeChanged">
                    <StackPanel>
                    <local:TimelineView x:Name="View" SelectionChanged="OnSelectionChanged" Scrubbed="OnTimelineScrubbed" Previewed="OnPreviewed"
                                        GestureFinished="OnGestureFinished" ZoomRequested="OnZoomRequested">
                        <local:TimelineView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Dividir aquí" InputGestureText="S" Click="OnSplit" />
                                <MenuItem Header="Duplicar" InputGestureText="Ctrl+D" Click="OnDuplicate" />
                                <MenuItem x:Name="MuteMenuItem" Header="Silenciar" InputGestureText="M" Click="OnMute" />
                                <MenuItem x:Name="SpeedMenuItem" Header="Velocidad" />
                                <Separator />
                                <MenuItem Header="Eliminar" InputGestureText="Supr" Click="OnDelete" />
                            </ContextMenu>
                        </local:TimelineView.ContextMenu>
                    </local:TimelineView>
                    <local:ZoomLaneView x:Name="Lane" Margin="0,0,0,4" SelectionChanged="OnZoomSelectionChanged" Scrubbed="OnScrubbed"
                                        AddRequested="OnZoomAddRequested" GestureFinished="OnGestureFinished" ZoomRequested="OnZoomRequested">
                        <local:ZoomLaneView.ContextMenu>
                            <ContextMenu x:Name="ZoomMenu">
                                <MenuItem Header="Quitar zoom" InputGestureText="Supr" Click="OnDeleteZoom" />
                            </ContextMenu>
                        </local:ZoomLaneView.ContextMenu>
                    </local:ZoomLaneView>
                    <local:OverlayLaneView x:Name="OverlayLane" Margin="0,0,0,4" SelectionChanged="OnOverlaySelectionChanged" Scrubbed="OnScrubbed"
                                           GestureFinished="OnGestureFinished" ZoomRequested="OnZoomRequested">
                        <local:OverlayLaneView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Quitar capa" InputGestureText="Supr" Click="OnDeleteOverlay" />
                            </ContextMenu>
                        </local:OverlayLaneView.ContextMenu>
                    </local:OverlayLaneView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Margin="2,8,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="KeptText" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectionText" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
