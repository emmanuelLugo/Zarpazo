<Window x:Class="Zarpazo.Recording.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarpazo"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="#FF202124">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" MinWidth="30" Height="30" Padding="10,0" CornerRadius="6" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#40FFFFFF" BorderThickness="1" Padding="8,6">
        <Grid>
            <!-- Recording -->
            <StackPanel x:Name="RecordingPanel" Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#E53935" Margin="2,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ElapsedText" Style="{StaticResource Label}" FontFamily="Consolas" Margin="0,0,10,0" />
                <StackPanel x:Name="MetersPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                <Button Style="{StaticResource Action}" Click="OnPause" ToolTip="Pausar o reanudar: lo que pase en la pausa no queda grabado" AutomationProperties.Name="Pausar">
                    <StackPanel Orientation="Horizontal">
                        <!-- Two bars while recording (press to pause); a triangle while paused (press to resume). -->
                        <Path x:Name="PauseIcon" Data="M1,0 H3.5 V10 H1 Z M6.5,0 H9 V10 H6.5 Z" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PauseText" Text="Pausa" Style="{StaticResource Label}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Action}" Click="OnStop" ToolTip="Detener (también con el atajo de captura)" AutomationProperties.Name="Detener">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" Fill="White" RadiusX="1.5" RadiusY="1.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Detener" Style="{StaticResource Label}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Action}" Click="OnCancel" ToolTip="Descartar la grabación" AutomationProperties.Name="Descartar">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#EF5350" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>

            <!-- Counting down to the start -->
            <StackPanel x:Name="CountdownPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="CountdownText" Style="{StaticResource Label}" Margin="4,0,10,0" />
                <Button Style="{StaticResource Action}" Click="OnCancel" ToolTip="Cancelar" AutomationProperties.Name="Cancelar">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#EF5350" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>

            <!-- Making the file -->
            <StackPanel x:Name="EncodingPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="EncodingText" Style="{StaticResource Label}" Margin="4,0,10,0" />
                <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" Margin="0,0,4,0" />
            </StackPanel>

            <!-- Ready -->
            <StackPanel x:Name="DonePanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="DoneText" Style="{StaticResource Label}" Margin="4,0,10,0" />
                <Button x:Name="EditButton" Style="{StaticResource Action}" Click="OnEdit" Visibility="Collapsed"
                        ToolTip="Cortar partes del video, cambiar su orden y guardar el resultado" AutomationProperties.Name="Editar">
                    <TextBlock Text="Editar…" Style="{StaticResource Label}" />
                </Button>
                <Button Style="{StaticResource Action}" Click="OnCopy" ToolTip="Copiar el archivo para pegarlo en un chat o un documento" AutomationProperties.Name="Copiar">
                    <TextBlock Text="Copiar" Style="{StaticResource Label}" />
                </Button>
                <Button Style="{StaticResource Action}" Click="OnSave" ToolTip="Guardar como archivo" AutomationProperties.Name="Guardar">
                    <TextBlock Text="Guardar…" Style="{StaticResource Label}" />
                </Button>
                <Button Style="{StaticResource Action}" Click="OnClose" ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>

            <!-- Something went wrong -->
            <StackPanel x:Name="FailurePanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="FailureText" Style="{StaticResource Label}" Foreground="#FFEF9A9A" Margin="4,0,10,0" MaxWidth="360" TextWrapping="Wrap" />
                <Button Style="{StaticResource Action}" Click="OnClose" AutomationProperties.Name="Cerrar">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
