<Window x:Class="Zarpazo.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial"
        Width="780"
        Height="540"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="EditButton" Content="Editar" Click="OnEdit" />
            <Button x:Name="CopyButton" Content="Copiar" Click="OnCopy" />
            <Button x:Name="SaveButton" Content="Guardar como…" Click="OnSave" />
            <Button x:Name="OpenButton" Content="Abrir" Click="OnOpen" />
            <Button x:Name="DeleteButton" Content="Eliminar" Click="OnDelete" />
            <Button Content="Abrir carpeta" Click="OnOpenFolder" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF666666" />
        </StackPanel>

        <Grid>
            <ListBox x:Name="Items"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnCopy">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="200" Margin="4">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Height="120" Stretch="Uniform" />
                                <!-- A recording is told apart from a capture by this tag over its first frame. -->
                                <Border Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisible}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                        Background="#CC202124" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="{Binding Kind, StringFormat='▶ {0}'}" Foreground="White" FontSize="11" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF666666" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       Foreground="#FF666666"
                       Text="Todavía no hay nada. Aquí aparecen las capturas que copias o guardas, y tus grabaciones." />
        </Grid>
    </DockPanel>
</Window>
