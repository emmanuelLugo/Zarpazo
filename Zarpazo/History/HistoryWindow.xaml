<Window x:Class="Zarpazo.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial"
        Width="780"
        Height="540"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16,14,16,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <StackPanel.Resources>
                <!-- Here, not in the window's resources, so BasedOn finds the themed button style and not itself. -->
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
            </StackPanel.Resources>
            <Button x:Name="EditButton" Content="Editar" Click="OnEdit" />
            <Button x:Name="CopyButton" Content="Copiar" Click="OnCopy" />
            <Button x:Name="SaveButton" Content="Guardar como…" Click="OnSave" />
            <Button x:Name="OpenButton" Content="Abrir" Click="OnOpen" />
            <Button x:Name="KeepButton" Content="Conservar" Click="OnKeep"
                    ToolTip="Una captura conservada no se borra sola: ni por el límite de cantidad ni por antigüedad" />
            <Button x:Name="DeleteButton" Content="Eliminar" Click="OnDelete" />
            <Button Content="Abrir carpeta" Click="OnOpenFolder" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox x:Name="KindFilter" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged" ToolTip="Qué mostrar">
                <ComboBoxItem Content="Todo" />
                <ComboBoxItem Content="Capturas" />
                <ComboBoxItem Content="Grabaciones" />
                <ComboBoxItem Content="Conservadas" />
            </ComboBox>
            <TextBlock DockPanel.Dock="Left" Text="Buscar texto:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Ctrl+F" />
        </DockPanel>

        <Grid>
            <ListBox x:Name="Items"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnItemDoubleClick"
                     KeyDown="OnItemsKeyDown"
                     PreviewMouseRightButtonDown="OnItemsRightClick"
                     ContextMenuOpening="OnContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="EditMenuItem" Header="Editar" InputGestureText="Intro" Click="OnEdit" />
                        <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="OnCopy" />
                        <MenuItem Header="Guardar como…" Click="OnSave" />
                        <MenuItem Header="Abrir" Click="OnOpen" />
                        <Separator />
                        <MenuItem x:Name="KeepMenuItem" Header="Conservar" Click="OnKeep" />
                        <MenuItem Header="Eliminar" InputGestureText="Supr" Click="OnDelete" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="200" Margin="4">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Height="120" Stretch="Uniform" />
                                <!-- A recording is told apart from a capture by this tag over its first frame. -->
                                <Border Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisible}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                        Background="#CC202124" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="{Binding Kind, StringFormat='▶ {0}'}" Foreground="White" FontSize="11" />
                                </Border>
                                <Border Visibility="{Binding Kept, Converter={StaticResource BoolToVisible}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                        Background="#CC202124" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="★ Conservada" Foreground="#FDD835" FontSize="11" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" Margin="0,4,0,6" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Todavía no hay nada. Aquí aparecen las capturas que copias o guardas, y tus grabaciones." />
        </Grid>
    </DockPanel>
</Window>
