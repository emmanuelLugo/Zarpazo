<Window x:Class="Zarpazo.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial"
        Width="800"
        Height="580"
        MinWidth="660"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />

            <!-- Icons drawn on a 16 x 16 grid, in the colour of the button they are in. -->
            <Style x:Key="Icon" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Geometry x:Key="IconCopy">M5.5,5.5 H13.5 V13.5 H5.5 Z M3.5,10.5 H2.5 V2.5 H10.5 V3.5</Geometry>
            <Geometry x:Key="IconEdit">M2.5,13.5 L3.3,10 L10.8,2.5 L13.5,5.2 L6,12.7 Z M9.2,4.1 L11.9,6.8</Geometry>
            <Geometry x:Key="IconStar">M8,2 L9.8,5.8 L14,6.3 L10.9,9.2 L11.7,13.3 L8,11.2 L4.3,13.3 L5.1,9.2 L2,6.3 L6.2,5.8 Z</Geometry>

            <!-- The filter: a few options side by side, as parts of one control. -->
            <Style x:Key="Filter" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="11,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The main action of the window. -->
            <Style x:Key="Primary" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="16,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentPressed}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A button of the quick actions over a picture; dark in both themes, like the capture bars. -->
            <Style x:Key="Quick" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Width="28" Height="28" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="#4DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The buttons of the bar under the grid: flat, no outline until the keyboard is on them. -->
            <Style x:Key="Flat" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Background" Value="{DynamicResource Surface}" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FlatIcon" TargetType="Button" BasedOn="{StaticResource Flat}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- A capture or a recording of the grid; its tile, in the item's template, shows when it is chosen. -->
            <Style x:Key="Card" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="Transparent" Margin="0,0,12,10">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Surface}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Hover}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="18,12,18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Grey like the rest; red only under the pointer, when it is about to be pressed. -->
                <Button x:Name="DeleteButton" Click="OnDelete" ToolTip="Eliminar (Supr)" AutomationProperties.Name="Eliminar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatIcon}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Style="{StaticResource Icon}" Data="M2.5,4.5 H13.5 M6,4.5 V2.5 H10 V4.5 M4,4.5 L4.7,13.5 H11.3 L12,4.5" />
                </Button>
                <DockPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MoreButton" Style="{StaticResource FlatIcon}" Click="OnMore" Margin="0,0,8,0" ToolTip="Más opciones"
                            AutomationProperties.Name="Más opciones">
                        <Path Style="{StaticResource Icon}" StrokeThickness="2.8" Data="M3,8 L3.01,8 M8,8 L8.01,8 M13,8 L13.01,8" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" Placement="Top">
                                <MenuItem x:Name="MoreOpenItem" Header="Abrir" Click="OnOpen" />
                                <MenuItem x:Name="MoreKeepItem" Header="Conservar" Click="OnKeep"
                                          ToolTip="Una captura conservada no se borra sola: ni por el límite de cantidad ni por antigüedad" />
                                <Separator />
                                <MenuItem Header="Abrir carpeta" Click="OnOpenFolder" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource Flat}" Content="Guardar como…" Click="OnSave" Margin="0,0,8,0" />
                    <Button x:Name="EditButton" Style="{StaticResource Flat}" Click="OnEdit" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconEdit}" />
                            <TextBlock Text="Editar" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource Primary}" Click="OnCopy" ToolTip="Copiar (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                            <TextBlock Text="Copiar" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="18,14,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The search box with its magnifying glass, a hint while it is empty and its shortcut. -->
            <Border x:Name="SearchFrame" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="10" Padding="11,0" Height="36">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="M2.5,7 A4.5,4.5 0 1 0 11.5,7 A4.5,4.5 0 1 0 2.5,7 M10.5,10.5 L14,14" Width="16" Height="16"
                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <Grid Margin="8,0">
                        <TextBlock Text="Buscar texto en las capturas" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="2,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalAlignment="Center" AutomationProperties.Name="Buscar texto en las capturas" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" Padding="3" Height="36" Background="{DynamicResource Surface}" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" GroupName="kind" Content="Todo" IsChecked="True" Style="{StaticResource Filter}" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterCaptures" GroupName="kind" Content="Capturas" Style="{StaticResource Filter}" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterRecordings" GroupName="kind" Content="Grabaciones" Style="{StaticResource Filter}" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterKept" GroupName="kind" Content="Conservadas" Style="{StaticResource Filter}" Checked="OnFilterChanged" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="18,0,4,0">
            <ListBox x:Name="Items"
                     ItemContainerStyle="{StaticResource Card}"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnItemDoubleClick"
                     KeyDown="OnItemsKeyDown"
                     PreviewMouseRightButtonDown="OnItemsRightClick"
                     ContextMenuOpening="OnContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="EditMenuItem" Header="Editar" InputGestureText="Intro" Click="OnEdit" />
                        <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="OnCopy" />
                        <MenuItem Header="Guardar como…" Click="OnSave" />
                        <MenuItem Header="Abrir" Click="OnOpen" />
                        <Separator />
                        <MenuItem x:Name="KeepMenuItem" Header="Conservar" Click="OnKeep" />
                        <MenuItem Header="Eliminar" InputGestureText="Supr" Click="OnDelete" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="236">
                            <Border Style="{StaticResource Tile}">
                            <Grid>
                                <Border Background="{DynamicResource InputBackground}" CornerRadius="6" />
                                <Image Source="{Binding Thumbnail}" Height="122" Stretch="Uniform" />
                                <!-- A recording is told apart from a capture by this tag over its first frame. -->
                                <Border Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisible}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                        Background="#D9202124" CornerRadius="5" Padding="7,1">
                                    <TextBlock Text="{Binding Kind, StringFormat='▶ {0}'}" Foreground="White" FontSize="11" />
                                </Border>
                                <Border Visibility="{Binding Kept, Converter={StaticResource BoolToVisible}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Width="22" Height="22"
                                        Background="#D9202124" CornerRadius="5" ToolTip="Conservada">
                                    <TextBlock Text="★" Foreground="#FDD835" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.Name="Conservada" />
                                </Border>
                                <!-- Shown only under the pointer; each one picks its card first, so it acts on that one. -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="3" CornerRadius="8"
                                        Background="#F2202124" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Quick}" Click="OnQuickCopy" ToolTip="Copiar" AutomationProperties.Name="Copiar">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                                        </Button>
                                        <Button Style="{StaticResource Quick}" Click="OnQuickEdit" ToolTip="Editar" AutomationProperties.Name="Editar"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisible}}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Style="{StaticResource Quick}" Click="OnQuickKeep" ToolTip="{Binding KeepLabel}" AutomationProperties.Name="{Binding KeepLabel}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconStar}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            </Border>
                            <DockPanel Margin="5,5,5,0" ToolTip="{Binding FullDate}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Date}" FontSize="12" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Over the list when it shows nothing: the mark and how to start when there is no history at all. -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,30">
                <StackPanel x:Name="EmptyWelcome" HorizontalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="22" HorizontalAlignment="Center" Background="{DynamicResource Surface}">
                        <Path Data="M9,4 L5,24 M15,4 L11,24 M21,4 L17,24" Stroke="{DynamicResource TextSecondary}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" Width="28" Height="28"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleX="1.9" ScaleY="1.9" />
                            </Path.LayoutTransform>
                        </Path>
                    </Border>
                    <TextBlock Text="Todavía no hay nada" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                </StackPanel>
                <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource TextSecondary}" />
                <StackPanel x:Name="EmptyShortcut" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="Pulsa" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <Border Margin="8,0" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,1,1,2"
                            CornerRadius="4" Padding="7,1">
                        <TextBlock x:Name="EmptyHotKey" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="para hacer una captura" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
