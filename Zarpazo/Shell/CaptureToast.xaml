<Window x:Class="Zarpazo.Shell.CaptureToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarpazo"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13">
    <!-- The margin leaves room for the shadow, which the transparent window would otherwise cut off. -->
    <Border x:Name="Card" Margin="14" Padding="14,11,18,11" MaxWidth="380" CornerRadius="10" Opacity="0" Cursor="Hand"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            MouseLeftButtonUp="OnClick">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <Path DockPanel.Dock="Left" Data="M2,8.5 L6,12.5 L14,3.5" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                  Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="Detail" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
