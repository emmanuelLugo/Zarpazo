<Window x:Class="Zarpazo.Shell.UpdateToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarpazo"
        Width="412"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zarpazo;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text-only button, for the close cross and the link to the release notes. -->
            <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The margin leaves room for the shadow, which the transparent window would otherwise cut off. -->
    <Border x:Name="Card" Margin="14" CornerRadius="10" Padding="16,14,12,14" Opacity="0"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="14" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The accent colour as a small round badge with an arrow, so it reads as "update" at a glance. -->
                <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Background="{DynamicResource Accent}">
                    <Path Data="M 0,-6 L 0,5 M -5,0 L 0,5.5 L 5,0" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,6,0">
                    <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Detail" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource Quiet}" Content="✕" VerticalAlignment="Top" ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar" Click="OnDismiss" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="46,12,0,0">
                <Button x:Name="RestartButton" Content="Reiniciar ahora" IsDefault="True" Click="OnRestart" />
                <Button x:Name="LaterButton" Content="Al cerrar" Margin="8,0,0,0" Click="OnLater" />
                <Button x:Name="NotesButton" Content="Novedades" Margin="4,0,0,0" Style="{StaticResource Quiet}" Click="OnNotes" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
